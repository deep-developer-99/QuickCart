der from \"../../components/common/RotatingSearchPlaceholder\";\nimport {\n  createSearchSuggestion, deleteSearchSuggestion, getAdminSearchSuggestions,\n  invalidatePublicSearchSuggestions, reorderSearchSuggestions,\n  updateSearchSuggestion, updateSearchSuggestionSettings,\n  type SearchSuggestion, type SearchSuggestionConfig,\n} from \"../../services/searchSuggestionService\";\nimport \"./AdminSearchSuggestions.css\";\n\nconst INTERVALS = [1500, 2000, 2500, 3000, 4000, 5000];\nconst errorText = (error: unknown) => axios.isAxiosError(error)\n  ? error.response?.data?.message || \"The request could not be completed.\"\n  : error instanceof Error ? error.message : \"The request could not be completed.\";\n\nconst AdminSearchSuggestions = () => {\n  const [data, setData] = useState<SearchSuggestionConfig>({ isEnabled: true, rotationInterval: 2500, suggestions: [] });\n  const [loading, setLoading] = useState(true);\n  const [saving, setSaving] = useState(false);\n  const [phrase, setPhrase] = useState(\"\");\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const [showForm, setShowForm] = useState(false);\n  const [active, setActive] = useState(true);\n  const [feedback, setFeedback] = useState(\"\");\n  const [error, setError] = useState(\"\");\n  const [draggedId, setDraggedId] = useState<string | null>(null);\n  const [settingsDraft, setSettingsDraft] = useState({ isEnabled: true, rotationInterval: 2500 });\n  const { index } = useSearchSuggestions();\n\n  const refresh = useCallback(async () => {\n    setLoading(true);\n    try {\n      const response = await getAdminSearchSuggestions();\n      setData(response.data);\n      setSettingsDraft({ isEnabled: response.data.isEnabled, rotationInterval: response.data.rotationInterval });\n      setError(\"\");\n    } catch (requestError) { setError(errorText(requestError)); }\n    finally { setLoading(false); }\n  }, []);\n\n  useEffect(() => { void refresh(); }, [refresh]);\n\n  const activeSuggestions = useMemo(() => data.suggestions.filter((suggestion) => suggestion.isActive !== false), [data.suggestions]);\n  const persistPublic = () => invalidatePublicSearchSuggestions();\n  const resetForm = () => { setPhrase(\"\"); setActive(true); setEditingId(null); setShowForm(false); };\n\n  const savePhrase = async (event: React.FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n    const trimmed = phrase.trim();\n    if (!trimmed) { setError(\"Enter a search phrase.\"); return; }\n    if (data.suggestions.some((item) => item._id !== editingId && item.phrase.trim().toLocaleLowerCase() === trimmed.toLocaleLowerCase())) {\n      setError(\"That phrase already exists.\"); return;\n    }\n    setSaving(true); setError(\"\"); setFeedback(\"\");\n    try {\n      if (editingId) await updateSearchSuggestion(editingId, { phrase: trimmed, isActive: active });\n      else await createSearchSuggestion({ phrase: trimmed, isActive: active });\n      resetForm(); await refresh(); persistPublic(); setFeedback(editingId ? \"Suggestion updated.\" : \"Suggestion added.\");\n    } catch (requestError) { setError(errorText(requestError)); }\n    finally { setSaving(false); }\n  };\n\n  const beginEdit = (suggestion: SearchSuggestion) => {\n    setEditingId(suggestion._id); setPhrase(suggestion.phrase); setActive(suggestion.isActive !== false); setError(\"\"); setFeedback(\"\");\n  };\n\n  const toggleActive = async (suggestion: SearchSuggestion) => {\n    setError(\"\"); setFeedback(\"\");\n    try { await updateSearchSuggestion(suggestion._id, { isActive: suggestion.isActive === false }); await refresh(); persistPublic(); setFeedback(\"Suggestion status updated.\"); }\n    catch (requestError) { setError(errorText(requestError)); }\n  };\n\n  const remove = async (suggestion: SearchSuggestion) => {\n    if (!window.confirm(`Delete “${suggestion.phrase}”?`)) return;\n    setError(\"\"); setFeedback(\"\");\n    try { await deleteSearchSuggestion(suggestion._id); if (editingId === suggestion._id) resetForm(); await refresh(); persistPublic(); setFeedback(\"Suggestion deleted.\"); }\n    catch (requestError) { setError(errorText(requestError)); }\n  };\n\n  const saveOrder = async (ordered: SearchSuggestion[]) => {\n    setData((current) => ({ ...current, suggestions: ordered }));\n    try { const response = await reorderSearchSuggestions(ordered.map((item) => item._id)); setData(response.data); persistPublic(); setFeedback(\"Suggestion order saved.\"); setError(\"\"); }\n    catch (requestError) { setError(errorText(requestError)); await refresh(); }\n  };\n\n  const saveSettings = async () => {\n    setSaving(true); setError(\"\"); setFeedback(\"\");\n    try { await updateSearchSuggestionSettings(settingsDraft); await refresh(); persistPublic(); setFeedback(\"Rotation settings saved.\"); }\n    catch (requestError) { setError(errorText(requestError)); }\n    finally { setSaving(false); }\n  };\n\n  const handleDrop = (target: SearchSuggestion) => {\n    if (!draggedId || draggedId === target._id) return;\n    const ordered = [...data.suggestions];\n    const from = ordered.findIndex((item) => item._id === draggedId);\n    const to = ordered.findIndex((item) => item._id === target._id);\n    if (from < 0 || to < 0) return;\n    const [moved] = ordered.splice(from, 1); ordered.splice(to, 0, moved);\n    setDraggedId(null); void saveOrder(ordered);\n  };\n\n  const dialogFocus = useDialogFocus<HTMLElement>(showForm, () => { resetForm(); });\n\n  return (\n    <div className=\"admin-search-suggestions\">\n      <header className=\"ass-header\"><div><span className=\"ass-eyebrow\">QUICKCART ADMIN</span><h1>Search Suggestions</h1><p>Manage the rotating search suggestions displayed on your website.</p></div></header>\n      <section className=\"ass-stats\" aria-label=\"Suggestion totals\">\n        <article><span>Total suggestions</span><strong>{data.suggestions.length}</strong></article>\n        <article><span>Active suggestions</span><strong>{activeSuggestions.length}</strong></article>\n        <article><span>Inactive suggestions</span><strong>{data.suggestions.length - activeSuggestions.length}</strong></article>\n      </section>\n      {feedback && <div className=\"ass-message success\" role=\"status\">{feedback}</div>}\n      {error && <div className=\"ass-message error\" role=\"alert\">{error}</div>}\n\n      <div className=\"ass-grid\">\n        <section className=\"ass-card ass-list-card\">\n          <div className=\"ass-card-heading\"><div><h2>Manage phrases</h2><p>Drag a row to change the display order.</p></div><button type=\"button\" className=\"ass-secondary\" onClick={() => { resetForm(); setShowForm(true); setError(\"\"); }}>Add suggestion</button></div>\n          {loading ? <p className=\"ass-empty\">Loading suggestions…</p> : data.suggestions.length === 0 ? <p className=\"ass-empty\">No suggestions yet. Add a phrase to begin.</p> : (\n            <ol className=\"ass-items\">\n              {data.suggestions.map((item, itemIndex) => <li key={item._id} draggable onDragStart={() => setDraggedId(item._id)} onDragEnd={() => setDraggedId(null)} onDragOver={(event) => event.preventDefault()} onDrop={() => handleDrop(item)} className={draggedId === item._id ? \"dragging\" : \"\"}>\n                <span className=\"ass-grip\" aria-label=\"Drag to reorder\">⠿</span><span className=\"ass-order\">{itemIndex + 1}</span><span className=\"ass-phrase\">{item.phrase}</span><span className={`ass-status${item.isActive === false ? \" inactive\" : \"\"}`}>{item.isActive === false ? \"Inactive\" : \"Active\"}</span>\n                <div className=\"ass-row-actions\"><button type=\"button\" onClick={() => toggleActive(item)}>{item.isActive === false ? \"Enable\" : \"Disable\"}</button><button type=\"button\" onClick={() => { beginEdit(item); setShowForm(true); }}>Edit</button><button type=\"button\" className=\"danger\" onClick={() => void remove(item)}>Delete</button></div>\n              </li>)}\n            </ol>\n          )}\n        </section>\n\n        {showForm && <div className=\"ass-modal-overlay\" role=\"presentation\" onMouseDown={(event) => { if (event.target === event.currentTarget) resetForm(); }}><section {...dialogFocus} className=\"ass-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ass-form-title\"><div className=\"ass-modal-heading\"><div><h2 id=\"ass-form-title\">{editingId ? \"Edit search suggestion\" : \"Add search suggestion\"}</h2><p>Suggestions can contain up to 100 characters.</p></div><button type=\"button\" className=\"ass-close\" aria-label=\"Close\" onClick={resetForm}>×</button></div><form className=\"ass-form\" onSubmit={savePhrase}>\n            <label htmlFor=\"ass-phrase\">Search phrase</label>\n            <input id=\"ass-phrase\" value={phrase} maxLength={100} placeholder=\"e.g. Search for fresh fruits\" onChange={(event) => setPhrase(event.target.value)} required />\n            <label className=\"ass-check\"><input type=\"checkbox\" checked={active} onChange={(event) => setActive(event.target.checked)} /> Active</label>\n            <div className=\"ass-form-actions\"><button type=\"submit\" disabled={saving}>{saving ? \"Saving…\" : editingId ? \"Save changes\" : \"Add suggestion\"}</button><button type=\"button\" className=\"ass-cancel\" onClick={resetForm}>Cancel</button></div>\n          </form></section></div>}\n\n        <div className=\"ass-side-column\">\n          <section className=\"ass-card ass-settings\">\n            <h2>Rotation settings</h2><p>Control whether suggestions rotate and how often they change.</p>\n            <label className=\"ass-check\"><input type=\"checkbox\" checked={settingsDraft.isEnabled} onChange={(event) => setSettingsDraft((current) => ({ ...current, isEnabled: event.target.checked }))} /> Enable dynamic suggestions</label>\n            <label className=\"ass-interval\" htmlFor=\"ass-interval\">Rotation interval</label>\n            <select id=\"ass-interval\" value={settingsDraft.rotationInterval} onChange={(event) => setSettingsDraft((current) => ({ ...current, rotationInterval: Number(event.target.value) }))}>\n              {INTERVALS.map((interval) => <option key={interval} value={interval}>{(interval / 1000).toFixed(interval % 1000 ? 1 : 0)} seconds ({interval} ms)</option>)}\n            </select>\n            <button type=\"button\" onClick={() => void saveSettings()} disabled={saving}>{saving ? \"Saving…\" : \"Save settings\"}</button>\n          </section>\n          <section className=\"ass-card ass-preview\"><h2>Live preview</h2><p>Preview the active phrases configured for your storefront.</p><div className=\"ass-preview-field\"><span className=\"ass-search-icon\" aria-hidden=\"true\">⌕</span><RotatingSearchPlaceholder suggestions={activeSuggestions} index={index} enabled={settingsDraft.isEnabled} fallback=\"Search for atta, milk and more\" /></div><small>{activeSuggestions.length ? `${activeSuggestions.length} active phrases · ${settingsDraft.rotationInterval} ms interval` : \"Static placeholder shown when no active phrases exist.\"}</small></section>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default AdminSearchSuggestions;\n","usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminSubCategories.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminTheme.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminUsers.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nD:\\QuickCart\\client\\src\\pages\\admin\\AdminUsers.tsx:60:5\n  58 |\n  59 |   useEffect(() => {\n> 60 |     fetchUsers();\n     |     ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  61 |   }, [page, status]);\n  62 |\n  63 |   if (isLoading) {","line":60,"column":5,"endLine":60,"endColumn":15},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchUsers'. Either include it or remove the dependency array.","line":61,"column":6,"endLine":61,"endColumn":20,"suggestions":[{"desc":"Update the dependencies array to be: [fetchUsers, page, status]","fix":{"range":[1723,1737],"text":"[fetchUsers, page, status]"}}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from \"react\";\nimport axios from \"axios\";\n\nimport { getAdminUsers } from \"../../services/adminService\";\nimport Pagination from \"../../components/common/Pagination\";\n\nimport \"./AdminUsers.css\";\n\ninterface AdminUser {\n  _id: string;\n  name: string;\n  email: string;\n  phone?: string;\n  profileImage?: string;\n  googleId?: string;\n  role: \"user\";\n  createdAt: string;\n  isActive?: boolean;\n  deletedAt?: string;\n}\n\nconst AdminUsers = () => {\n  const [users, setUsers] = useState<AdminUser[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [error, setError] = useState(\"\");\n  const [status, setStatus] = useState(\"all\");\n  const [page, setPage] = useState(1);\n  const [totalPages, setTotalPages] = useState(1);\n  const [totalItems, setTotalItems] = useState(0);\n\n  const fetchUsers = async (requestedPage = page) => {\n    try {\n      setIsLoading(true);\n      setError(\"\");\n\n      const response = await getAdminUsers(requestedPage, 10, status);\n\n      if (response?.success) {\n        setUsers(response.data || []);\n        setTotalPages(response.pagination?.totalPages || 1);\n        if (requestedPage > (response.pagination?.totalPages || 1)) setPage(response.pagination?.totalPages || 1);\n        setTotalItems(response.pagination?.totalItems || 0);\n      } else {\n        setError(\"Failed to load users.\");\n      }\n    } catch (error: unknown) {\n      console.error(\"Get users error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(error.response?.data?.message || \"Failed to load users.\");\n      } else {\n        setError(\"Failed to load users.\");\n      }\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchUsers();\n  }, [page, status]);\n\n  if (isLoading) {\n    return (\n      <div className=\"admin-users-page\">\n        <div className=\"admin-users-loading\">Loading users...</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"admin-users-page\">\n      <div className=\"admin-users-container\">\n        <div className=\"admin-page-header\">\n          <div>\n            <h1>Manage Users</h1>\n            <p>View all registered QuickCart users.</p>\n          </div>\n\n          <div className=\"admin-count\">\n            {totalItems} {totalItems === 1 ? \"User\" : \"Users\"}\n          </div>\n        </div>\n\n        <label className=\"admin-users-status-filter\">Account status\n          <select value={status} onChange={(event) => { setStatus(event.target.value); setPage(1); }}>\n            <option value=\"all\">All historical accounts</option>\n            <option value=\"active\">Active</option>\n            <option value=\"deactivated\">Deactivated</option>\n          </select>\n        </label>\n        {error && <div className=\"admin-page-error\">{error}</div>}\n\n        {users.length === 0 ? (\n          <div className=\"admin-empty\">\n            <div>👥</div>\n            <h3>No Users Found</h3>\n            <p>There are no registered users yet.</p>\n          </div>\n        ) : (\n          <div className=\"admin-table-wrapper\" role=\"region\" aria-label=\"Users table\" tabIndex={0}>\n            <table className=\"admin-table\">\n              <thead>\n                <tr>\n                  <th>User</th>\n                  <th>Email</th>\n                  <th>Phone</th>\n                  <th>Login Method</th>\n                  <th>Status</th>\n                  <th>Deactivated</th>\n                  <th>Joined</th>\n                </tr>\n              </thead>\n\n              <tbody>\n                {users.map((user) => (\n                  <tr key={user._id}>\n                    <td>\n                      <div className=\"user-info\">\n                        {user.profileImage ? (\n                          <img\n                            src={user.profileImage}\n                            alt={user.name}\n                            className=\"user-avatar\"\n                          />\n                        ) : (\n                          <div className=\"user-avatar-placeholder\">\n                            {user.name.charAt(0).toUpperCase()}\n                          </div>\n                        )}\n\n                        <div>\n                          <strong>{user.name}</strong>\n                          <span>{user.role}</span>\n                        </div>\n                      </div>\n                    </td>\n\n                    <td>{user.email || \"N/A\"}</td>\n\n                    <td>{user.phone || \"N/A\"}</td>\n\n                    <td>\n                      <span className=\"method-badge\">\n                        {user.googleId ? \"Google\" : \"Phone\"}\n                      </span>\n                    </td>\n\n                    <td>\n                      <span className={`customer-status ${user.isActive === false ? \"customer-status--inactive\" : \"\"}`}>{user.isActive === false ? \"Deactivated\" : \"Active\"}</span>\n                    </td>\n                    <td>{user.deletedAt ? new Date(user.deletedAt).toLocaleDateString(\"en-IN\") : \"—\"}</td>\n                    <td>\n                      {new Date(user.createdAt).toLocaleDateString(\"en-IN\")}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n        <Pagination currentPage={page} totalPages={totalPages} totalItems={totalItems} onPageChange={setPage} />\n      </div>\n    </div>\n  );\n};\n\nexport default AdminUsers;\n","usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminVendors.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nD:\\QuickCart\\client\\src\\pages\\admin\\AdminVendors.tsx:68:5\n  66 |\n  67 |   useEffect(() => {\n> 68 |     fetchVendors();\n     |     ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  69 |   }, [page]);\n  70 |\n  71 |   const handleAction = async (","line":68,"column":5,"endLine":68,"endColumn":17},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchVendors'. Either include it or remove the dependency array.","line":69,"column":6,"endLine":69,"endColumn":12,"suggestions":[{"desc":"Update the dependencies array to be: [fetchVendors, page]","fix":{"range":[1915,1921],"text":"[fetchVendors, page]"}}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from \"react\";\nimport axios from \"axios\";\n\nimport {\n  getAdminVendors,\n  approveVendor,\n  rejectVendor,\n  deactivateVendor,\n  activateVendor,\n} from \"../../services/adminService\";\nimport Pagination from \"../../components/common/Pagination\";\n\nimport \"./AdminVendors.css\";\n\ninterface AdminVendor {\n  _id: string;\n  name: string;\n  email: string;\n  shopName: string;\n  phone?: string;\n  address?: string;\n  isApproved: boolean;\n  isActive: boolean;\n  status: \"pending\" | \"approved\" | \"rejected\";\n  createdAt: string;\n}\n\nconst AdminVendors = () => {\n  const [vendors, setVendors] = useState<AdminVendor[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [processingId, setProcessingId] = useState<string | null>(null);\n\n  const [error, setError] = useState(\"\");\n  const [success, setSuccess] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [totalPages, setTotalPages] = useState(1);\n  const [totalItems, setTotalItems] = useState(0);\n\n  const fetchVendors = async (requestedPage = page) => {\n    try {\n      setIsLoading(true);\n      setError(\"\");\n\n      const response = await getAdminVendors(requestedPage, 10);\n\n      if (response?.success) {\n        setVendors(response.data || []);\n        setTotalPages(response.pagination?.totalPages || 1);\n        if (requestedPage > (response.pagination?.totalPages || 1)) setPage(response.pagination?.totalPages || 1);\n        setTotalItems(response.pagination?.totalItems || 0);\n      } else {\n        setError(\"Failed to load vendors\");\n      }\n    } catch (error: unknown) {\n      console.error(\"Get vendors error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(error.response?.data?.message || \"Failed to load vendors\");\n      } else {\n        setError(\"Failed to load vendors.\");\n      }\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchVendors();\n  }, [page]);\n\n  const handleAction = async (\n    id: string,\n    action: \"approve\" | \"reject\" | \"activate\" | \"deactivate\",\n  ) => {\n    try {\n      setProcessingId(id);\n      setError(\"\");\n      setSuccess(\"\");\n\n      let response;\n\n      if (action === \"approve\") {\n        response = await approveVendor(id);\n      } else if (action === \"reject\") {\n        response = await rejectVendor(id);\n      } else if (action === \"activate\") {\n        response = await activateVendor(id);\n      } else {\n        response = await deactivateVendor(id);\n      }\n\n      if (response?.success) {\n        setSuccess(response.message || \"Vendor updated successfully.\");\n        await fetchVendors();\n      }\n    } catch (error: unknown) {\n      console.error(\"Vendor action error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(error.response?.data?.message || \"Failed to update vendor.\");\n      } else {\n        setError(\"Failed to update vendor.\");\n      }\n    } finally {\n      setProcessingId(null);\n    }\n  };\n\n  if (isLoading) {\n    return (\n      <div className=\"admin-vendors-page\">\n        <div className=\"admin-vendors-loading\">Loading vendors...</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"admin-vendors-page\">\n      <div className=\"admin-vendors-container\">\n        <div className=\"admin-page-header\">\n          <div>\n            <h1>Manage Vendors</h1>\n            <p>Approve and manage QuickCart vendors.</p>\n          </div>\n\n          <div className=\"admin-count\">\n            {totalItems} {totalItems === 1 ? \"Vendor\" : \"Vendors\"}\n          </div>\n        </div>\n\n        {error && <div className=\"admin-page-error\">{error}</div>}\n\n        {success && <div className=\"admin-page-success\">{success}</div>}\n\n        {vendors.length === 0 ? (\n          <div className=\"admin-empty\">\n            <div>🏪</div>\n            <h3>No Vendors Found</h3>\n            <p>There are no registered vendors yet.</p>\n          </div>\n        ) : (\n          <div className=\"admin-table-wrapper\" role=\"region\" aria-label=\"Vendors table\" tabIndex={0}>\n            <table className=\"admin-table\">\n              <thead>\n                <tr>\n                  <th>Vendor</th>\n                  <th>Shop</th>\n                  <th>Contact</th>\n                  <th>Status</th>\n                  <th>Account</th>\n                  <th>Actions</th>\n                </tr>\n              </thead>\n\n              <tbody>\n                {vendors.map((vendor) => (\n                  <tr key={vendor._id}>\n                    <td>\n                      <strong>{vendor.name}</strong>\n                      <span className=\"table-subtext\">{vendor.email}</span>\n                    </td>\n\n                    <td>{vendor.shopName}</td>\n\n                    <td>\n                      <div>{vendor.phone || \"N/A\"}</div>\n                      <span className=\"table-subtext\">\n                        {vendor.address || \"No address\"}\n                      </span>\n                    </td>\n\n                    <td>\n                      <span className={`status-badge status-${vendor.status}`}>\n                        {vendor.status}\n                      </span>\n                    </td>\n\n                    <td>\n                      <span\n                        className={`account-badge ${\n                          vendor.isActive ? \"active\" : \"inactive\"\n                        }`}\n                      >\n                        {vendor.isActive ? \"Active\" : \"Inactive\"}\n                      </span>\n                    </td>\n\n                    <td>\n                      <div className=\"vendor-actions\">\n                        {vendor.status === \"pending\" && (\n                          <>\n                            <button\n                              type=\"button\"\n                              className=\"approve-button\"\n                              disabled={processingId === vendor._id}\n                              onClick={() =>\n                                handleAction(vendor._id, \"approve\")\n                              }\n                            >\n                              Approve\n                            </button>\n\n                            <button\n                              type=\"button\"\n                              className=\"reject-button\"\n                              disabled={processingId === vendor._id}\n                              onClick={() => handleAction(vendor._id, \"reject\")}\n                            >\n                              Reject\n                            </button>\n                          </>\n                        )}\n\n                        {vendor.status === \"rejected\" && (\n                          <button\n                            type=\"button\"\n                            className=\"approve-button\"\n                            disabled={processingId === vendor._id}\n                            onClick={() => handleAction(vendor._id, \"approve\")}\n                          >\n                            Approve\n                          </button>\n                        )}\n\n                        {vendor.isActive ? (\n                          <button\n                            type=\"button\"\n                            className=\"deactivate-button\"\n                            disabled={processingId === vendor._id}\n                            onClick={() =>\n                              handleAction(vendor._id, \"deactivate\")\n                            }\n                          >\n                            Deactivate\n                          </button>\n                        ) : (\n                          <button\n                            type=\"button\"\n                            className=\"activate-button\"\n                            disabled={processingId === vendor._id}\n                            onClick={() => handleAction(vendor._id, \"activate\")}\n                          >\n                            Activate\n                          </button>\n                        )}\n                      </div>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n        <Pagination currentPage={page} totalPages={totalPages} totalItems={totalItems} onPageChange={setPage} />\n      </div>\n    </div>\n  );\n};\n\nexport default AdminVendors;\n","usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\FooterDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\FooterFields.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\FooterLinkManager.tsx","messages"