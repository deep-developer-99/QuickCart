effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nD:\\QuickCart\\client\\src\\pages\\user\\CategoryProducts.tsx:51:5\n  49 |     inFlightRef.current = false;\n  50 |     requestedPageRef.current = 1;\n> 51 |     setIsInitialLoading(true);\n     |     ^^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  52 |     setCategoryError(\"\");\n  53 |     setProductError(\"\");\n  54 |     setCategoryReadyId(\"\");","line":51,"column":5,"endLine":51,"endColumn":24},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nD:\\QuickCart\\client\\src\\pages\\user\\CategoryProducts.tsx:105:7\n  103 |       inFlightRef.current = false;\n  104 |       requestedPageRef.current = 1;\n> 105 |       setPage(1);\n      |       ^^^^^^^ Avoid calling setState() directly within an effect\n  106 |       setProducts([]);\n  107 |       setPagination({ currentPage: 1, totalPages: 1, totalItems: 0, hasNextPage: false });\n  108 |       setHasLoadedFirstPage(false);","line":105,"column":7,"endLine":105,"endColumn":14},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'selectedSubcategory'. Either include it or remove the dependency array.","line":114,"column":6,"endLine":114,"endColumn":74,"suggestions":[{"desc":"Update the dependencies array to be: [categoryId, categoryReadyId, requestedSubcategoryId, selectedSubcategory, subcategories]","fix":{"range":[4732,4800],"text":"[categoryId, categoryReadyId, requestedSubcategoryId, selectedSubcategory, subcategories]"}}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useCallback, useEffect, useRef, useState } from \"react\";\nimport { Link, useParams, useSearchParams } from \"react-router-dom\";\n\nimport {\n  getCategoryById,\n  getProductsByCategory,\n  getSubcategories,\n} from \"../../services/productService\";\nimport type { Category, Product } from \"../../types/product\";\nimport { activeSubcategoriesForParent, getDefaultSubcategoryId } from \"../../utils/categorySelection\";\nimport ProductCard from \"../../components/user/ProductCard\";\nimport \"./CategoryProducts.css\";\n\nconst PAGE_SIZE = 15;\n\ninterface ProductPage {\n  currentPage: number;\n  totalPages: number;\n  totalItems: number;\n  hasNextPage: boolean;\n}\n\nconst CategoryProducts = () => {\n  const { categoryId } = useParams<{ categoryId: string }>();\n  const [searchParams] = useSearchParams();\n  const requestedSubcategoryId = searchParams.get(\"subCategory\") || \"\";\n  const [products, setProducts] = useState<Product[]>([]);\n  const [category, setCategory] = useState<Category | null>(null);\n  const [subcategories, setSubcategories] = useState<Category[]>([]);\n  const [selectedSubcategory, setSelectedSubcategory] = useState(\"\");\n  const [categoryReadyId, setCategoryReadyId] = useState(\"\");\n  const [isInitialLoading, setIsInitialLoading] = useState(true);\n  const [isProductsLoading, setIsProductsLoading] = useState(false);\n  const [categoryError, setCategoryError] = useState(\"\");\n  const [productError, setProductError] = useState(\"\");\n  const [productRetry, setProductRetry] = useState(0);\n  const [page, setPage] = useState(1);\n  const [pagination, setPagination] = useState<ProductPage>({ currentPage: 1, totalPages: 1, totalItems: 0, hasNextPage: false });\n  const [hasLoadedFirstPage, setHasLoadedFirstPage] = useState(false);\n  const productScrollRef = useRef<HTMLElement | null>(null);\n  const sentinelRef = useRef<HTMLDivElement | null>(null);\n  const inFlightRef = useRef(false);\n  const requestedPageRef = useRef(1);\n  const generationRef = useRef(0);\n\n  useEffect(() => {\n    let current = true;\n    generationRef.current += 1;\n    inFlightRef.current = false;\n    requestedPageRef.current = 1;\n    setIsInitialLoading(true);\n    setCategoryError(\"\");\n    setProductError(\"\");\n    setCategoryReadyId(\"\");\n    setCategory(null);\n    setSubcategories([]);\n    setSelectedSubcategory(\"\");\n    setProducts([]);\n    setPage(1);\n    setPagination({ currentPage: 1, totalPages: 1, totalItems: 0, hasNextPage: false });\n    setHasLoadedFirstPage(false);\n\n    if (!categoryId) {\n      setIsInitialLoading(false);\n      return () => { current = false; };\n    }\n\n    Promise.all([getCategoryById(categoryId), getSubcategories(categoryId)])\n      .then(([categoryResponse, subcategoryResponse]) => {\n        if (!current) return;\n        if (!categoryResponse?.success || !categoryResponse.data) throw new Error(\"Category not found.\");\n        if (!subcategoryResponse?.success || !Array.isArray(subcategoryResponse.data)) throw new Error(\"Failed to load subcategories.\");\n        const activeSubcategories = activeSubcategoriesForParent(subcategoryResponse.data as Category[], categoryId);\n        setCategory(categoryResponse.data as Category);\n        setSubcategories(activeSubcategories);\n        const urlSubcategory = new URLSearchParams(window.location.search).get(\"subCategory\") || \"\";\n        setSelectedSubcategory(\n          activeSubcategories.some((item) => item._id === urlSubcategory)\n            ? urlSubcategory\n            : getDefaultSubcategoryId(activeSubcategories),\n        );\n        setCategoryReadyId(categoryId);\n      })\n      .catch((requestError: unknown) => {\n        if (!current) return;\n        setCategoryError(requestError instanceof Error ? requestError.message : \"Failed to load category.\");\n      })\n      .finally(() => {\n        if (current) setIsInitialLoading(false);\n      });\n\n    return () => { current = false; };\n  }, [categoryId]);\n\n  // Keep direct links reactive when the query string changes while this page is open.\n  useEffect(() => {\n    if (categoryReadyId !== categoryId) return;\n    const nextSubcategory = subcategories.some((item) => item._id === requestedSubcategoryId)\n      ? requestedSubcategoryId\n      : getDefaultSubcategoryId(subcategories);\n    if (selectedSubcategory !== nextSubcategory) {\n      generationRef.current += 1;\n      inFlightRef.current = false;\n      requestedPageRef.current = 1;\n      setPage(1);\n      setProducts([]);\n      setPagination({ currentPage: 1, totalPages: 1, totalItems: 0, hasNextPage: false });\n      setHasLoadedFirstPage(false);\n      setProductError(\"\");\n      setIsProductsLoading(false);\n      if (productScrollRef.current) productScrollRef.current.scrollTop = 0;\n      setSelectedSubcategory(nextSubcategory);\n    }\n  }, [categoryId, categoryReadyId, requestedSubcategoryId, subcategories]);\n\n  const loadNextPage = useCallback(() => {\n    if (inFlightRef.current || requestedPageRef.current > page || !pagination.hasNextPage || productError) return;\n    const next = page + 1;\n    requestedPageRef.current = next;\n    setPage(next);\n  }, [page, pagination.hasNextPage, productError]);\n\n  useEffect(() => {\n    if (!categoryId || categoryReadyId !== categoryId || categoryError) return;\n    if (subcategories.length > 0 && !subcategories.some((item) => item._id === selectedSubcategory)) return;\n    if (inFlightRef.current) return;\n\n    let current = true;\n    const generation = generationRef.current;\n    inFlightRef.current = true;\n    setIsProductsLoading(true);\n    setProductError(\"\");\n\n    getProductsByCategory(categoryId, page, PAGE_SIZE, selectedSubcategory || undefined)\n      .then((response) => {\n        if (!current || generation !== generationRef.current) return;\n        if (!response?.success || !Array.isArray(response.data)) throw new Error(\"Failed to load products.\");\n        const meta = response.pagination || {};\n        const nextPagination: ProductPage = {\n          currentPage: Number(meta.currentPage) || page,\n          totalPages: Number(meta.totalPages) || 1,\n          totalItems: Number(meta.totalItems) || 0,\n          hasNextPage: Boolean(meta.hasNextPage),\n        };\n        setProducts((existing) => {\n          const combined = page === 1 ? response.data as Product[] : [...existing, ...response.data as Product[]];\n          const unique = new Map<string, Product>();\n          combined.forEach((product) => unique.set(product._id, product));\n          return [...unique.values()];\n        });\n        setPagination(nextPagination);\n        requestedPageRef.current = nextPagination.currentPage;\n        setHasLoadedFirstPage(true);\n      })\n      .catch((requestError: unknown) => {\n        if (!current || generation !== generationRef.current) return;\n        setProductError(requestError instanceof Error ? requestError.message : \"Failed to load products. Please try again.\");\n      })\n      .finally(() => {\n        if (current && generation === generationRef.current) {\n          inFlightRef.current = false;\n          setIsProductsLoading(false);\n        }\n      });\n\n    return () => { current = false; };\n  }, [categoryId, categoryReadyId, categoryError, selectedSubcategory, subcategories, page, productRetry]);\n\n  // The observer root is the product pane itself, so the browser window never drives loading.\n  useEffect(() => {\n    const root = productScrollRef.current;\n    const target = sentinelRef.current;\n    if (!root || !target || !pagination.hasNextPage || productError) return;\n    const observer = new IntersectionObserver((entries) => {\n      if (entries.some((entry) => entry.isIntersecting)) loadNextPage();\n    }, { root, rootMargin: \"240px 0px\", threshold: 0 });\n    observer.observe(target);\n    return () => observer.disconnect();\n  }, [loadNextPage, pagination.hasNextPage, products.length, productError]);\n\n  const selectSubcategory = (subcategoryId: string) => {\n    if (subcategoryId === selectedSubcategory) return;\n    generationRef.current += 1;\n    requestedPageRef.current = 1;\n    inFlightRef.current = false;\n    setPage(1);\n    setProducts([]);\n    setPagination({ currentPage: 1, totalPages: 1, totalItems: 0, hasNextPage: false });\n    setHasLoadedFirstPage(false);\n    setProductError(\"\");\n    setIsProductsLoading(false);\n    setSelectedSubcategory(subcategoryId);\n    if (productScrollRef.current) productScrollRef.current.scrollTop = 0;\n  };\n\n  const retryProducts = () => {\n    setProductError(\"\");\n    setProductRetry((retry) => retry + 1);\n  };\n\n  if (!categoryId) {\n    return <div className=\"category-products-page\"><div className=\"category-products-error\"><h2>Category not found</h2><p>Choose a category from the home page to continue shopping.</p><Link to=\"/\">Go back home</Link></div></div>;\n  }\n\n  if (isInitialLoading || categoryReadyId !== categoryId) {\n    return <div className=\"category-products-page\"><div className=\"category-products-loading\"><div className=\"category-products-spinner\" /><p>Loading category...</p></div></div>;\n  }\n\n  if (categoryError) {\n    return <div className=\"category-products-page\"><div className=\"category-products-error\"><div className=\"category-products-error-icon\" aria-hidden=\"true\">⚠️</div><h2>Something went wrong</h2><p>{categoryError}</p><Link to=\"/\">Go back home</Link></div></div>;\n  }\n\n  const currentSubcategory = subcategories.find((item) => item._id === selectedSubcategory);\n  const infoCategory = currentSubcategory || category;\n  const infoDescription = infoCategory?.description?.trim();\n\n  return (\n    <div className=\"category-products-page\">\n      <section className=\"category-shopping-container\" aria-label={`${category?.name || \"Category\"} shopping`}>\n        <div className={`category-products-layout${subcategories.length ? \" has-subcategories\" : \"\"}`}>\n          {subcategories.length > 0 && (\n            <aside className=\"category-subcategory-sidebar\">\n              <nav className=\"category-subcategory-nav\" aria-label=\"Subcategories\">\n                {subcategories.map((subcategory) => (\n                  <button type=\"button\" key={subcategory._id}\n                    className={`category-subcategory-option${subcategory._id === selectedSubcategory ? \" active\" : \"\"}`}\n                    onClick={() => selectSubcategory(subcategory._id)}\n                    aria-current={subcategory._id === selectedSubcategory ? \"true\" : undefined}>\n                    {subcategory.image ? <img src={subcategory.image} alt=\"\" /> : <span className=\"category-subcategory-placeholder\" aria-hidden=\"true\">▧</span>}\n                    <span>{subcategory.name}</span>\n                  </button>\n                ))}\n              </nav>\n            </aside>\n          )}\n\n          <section ref={productScrollRef} className=\"category-products-main\" aria-label=\"Category products\" aria-busy={isProductsLoading}>\n            <div className=\"category-products-result\">\n              <span>{pagination.totalItems} {pagination.totalItems === 1 ? \"product\" : \"products\"} available</span>\n            </div>\n\n            {productError && !hasLoadedFirstPage ? (\n              <div className=\"category-products-inline-error\" role=\"alert\"><span>{productError}</span><button type=\"button\" onClick={retryProducts}>Retry</button></div>\n            ) : products.length > 0 ? (\n              <>\n                <div className=\"category-products-grid\">\n                  {products.map((product) => <ProductCard key={product._id} product={product} variant=\"category\" />)}\n                  {isProductsLoading && Array.from({ length: 6 }, (_, index) => <div className=\"category-product-skeleton\" key={`skeleton-${index}`} aria-hidden=\"true\"><span className=\"category-product-skeleton-image\" /><span className=\"category-product-skeleton-line\" /><span className=\"category-product-skeleton-line short\" /></div>)}\n                </div>\n                <div ref={sentinelRef} className=\"category-products-sentinel\" aria-hidden=\"true\" />\n                {productError && <div className=\"category-products-inline-error\" role=\"alert\"><span>{productError}</span><button type=\"button\" onClick={retryProducts}>Retry</button></div>}\n                {hasLoadedFirstPage && !pagination.hasNextPage && <p className=\"category-products-end\">You’ve reached the end of the list.</p>}\n              </>\n            ) : isProductsLoading || !hasLoadedFirstPage ? (\n              <div className=\"category-products-grid category-products-grid--loading\" aria-label=\"Loading products\">\n                {Array.from({ length: 15 }, (_, index) => <div className=\"category-product-skeleton\" key={index}><span className=\"category-product-skeleton-image\" /><span className=\"category-product-skeleton-line\" /><span className=\"category-product-skeleton-line short\" /></div>)}\n              </div>\n            ) : (\n              <div className=\"category-products-empty\"><div className=\"category-products-empty-icon\" aria-hidden=\"true\">🛒</div><h2>No Products Found</h2><p>{currentSubcategory ? `There are currently no products in ${currentSubcategory.name}.` : \"There are currently no products available in this category.\"}</p><Link to=\"/\">Continue Shopping</Link></div>\n            )}\n          </section>\n        </div>\n      </section>\n\n      {infoCategory && infoDescription && (\n        <section className=\"category-subcategory-info\" aria-labelledby=\"category-subcategory-info-title\">\n          <h2 id=\"category-subcategory-info-title\">{infoCategory.name} Online</h2>\n          <div className=\"category-subcategory-info-content\">{infoDescription}</div>\n        </section>\n      )}\n    </div>\n  );\n};\n\nexport default CategoryProducts;\n","usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\user\\Checkout.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nD:\\QuickCart\\client\\src\\pages\\user\\Checkout.tsx:150:5\n  148 |     if (!isCartReady) return;\n  149 |     let active = true;\n> 150 |     setIsLoading(true);\n      |     ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  151 |     setCart(localCart);\n  152 |     setCheckoutSummary(null);\n  153 |     setCheckoutError(\"\");","line":150,"column":5,"endLine":150,"endColumn":17},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'handleRazorpayPayment'. Either include it or remove the dependency array.","line":610,"column":6,"endLine":610,"endColumn":102,"suggestions":[{"desc":"Update the dependencies array to be: [autoStartPayment, cart, checkoutSummary, handleRazorpayPayment, hasUnacceptedPriceChanges, isLoading, selectedAddress]","fix":{"range":[22456,22552],"text":"[autoStartPayment, cart, checkoutSummary, handleRazorpayPayment, hasUnacceptedPriceChanges, isLoading, selectedAddress]"}}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useRef, useState } from \"react\";\r\n\r\nimport { useLocation, useNavigate } from \"react-router-dom\";\r\n\r\nimport axios from \"axios\";\r\n\r\nimport { getCheckoutSummary } from \"../../services/orderService\";\r\n\r\nimport { createAddress, getAddresses, updateAddress } from \"../../services/addressService\";\r\n\r\nimport { detectCurrentLocation } from \"../../services/locationService\";\r\nimport AddressMap from \"../../components/common/AddressMap\";\r\n\r\nimport {\r\n  createOrder,\r\n  createRazorpayOrder,\r\n  verifyRazorpayPayment,\r\n} from \"../../services/orderService\";\r\n\r\nimport type { Address, CreateAddressData } from \"../../types/address\";\r\n\r\nimport type { Cart } from \"../../types/cart\";\r\nimport type { Order } from \"../../types/order\";\r\nimport type { CheckoutSummary } from \"../../services/orderService\";\r\n\r\nimport { loadRazorpayScript } from \"../../utils/razorpay\";\r\nimport { getConfirmedOrder } from \"../../utils/confirmedOrder\";\r\nimport { getCartItemUnitPrice, getCartProductId, getCartSubtotal } from \"../../utils/hasValidCartItems\";\r\n\r\nimport { useAppSelector } from \"../../hooks/reduxHooks\";\r\nimport { useCart } from \"../../context/useCart\";\r\nimport { useTheme } from \"../../theme/ThemeContext\";\r\n\r\nimport \"./Checkout.css\";\r\n\r\nconst normalizePhone = (phone?: string) => {\r\n  if (!phone) {\r\n    return \"\";\r\n  }\r\n\r\n  const digits = phone.replace(/\\D/g, \"\");\r\n\r\n  // Supports values such as +91XXXXXXXXXX as well as XXXXXXXXXX.\r\n  return digits.length > 10 ? digits.slice(-10) : digits;\r\n};\r\n\r\ninterface CheckoutProps {\r\n  embedded?: boolean;\r\n  initialSelectedAddress?: string;\r\n  onBack?: () => void;\r\n  onAddressChange?: (address: Address | undefined) => void;\r\n  onOrderSuccess?: (order: Order | undefined, address: Address | undefined) => void;\r\n  donationSelected?: boolean;\r\n  autoStartPayment?: boolean;\r\n}\r\n\r\nconst Checkout = ({ embedded = false, initialSelectedAddress, onBack, onAddressChange, onOrderSuccess, donationSelected = false, autoStartPayment = false }: CheckoutProps) => {\r\n  const navigate = useNavigate();\r\n  const location = useLocation();\r\n  const { colors } = useTheme();\r\n\r\n  const user = useAppSelector((state) => state.auth.user);\r\n  const { cart: localCart, isCartReady, removePurchasedItems } = useCart();\r\n\r\n  const [cart, setCart] = useState<Cart | null>(null);\r\n  const [checkoutSummary, setCheckoutSummary] = useState<CheckoutSummary | null>(null);\r\n  const [priceChangesAccepted, setPriceChangesAccepted] = useState(false);\r\n\r\n  const [addresses, setAddresses] = useState<Address[]>([]);\r\n\r\n  const routeState = location.state as { selectedAddressId?: string; donationSelected?: boolean } | null;\r\n  const [selectedAddress, setSelectedAddress] = useState(initialSelectedAddress || routeState?.selectedAddressId || (user?.id ? window.sessionStorage.getItem(`quickcart-selected-address:${user.id}`) || \"\" : \"\"));\r\n  const [editingAddressId, setEditingAddressId] = useState(\"\");\r\n  const [showAddressPicker, setShowAddressPicker] = useState(false);\r\n  const [addressError, setAddressError] = useState(\"\");\r\n  const addressPickerRef = useRef<HTMLDivElement>(null);\r\n\r\n  const [paymentMethod, setPaymentMethod] = useState<\"COD\" | \"RAZORPAY\" | \"\">(\"\");\r\n  const [checkoutDonationSelected] = useState(Boolean(routeState?.donationSelected ?? (user?.id && window.sessionStorage.getItem(`quickcart-cart-donation:${user.id}`) === \"true\")));\r\n  const donationAmountSelected = embedded ? donationSelected : checkoutDonationSelected;\r\n\r\n  const [showAddressForm, setShowAddressForm] = useState(\r\n    Boolean(\r\n      (location.state as { openAddressForm?: boolean } | null | undefined)\r\n        ?.openAddressForm,\r\n    ),\r\n  );\r\n\r\n  const [addressForm, setAddressForm] = useState<CreateAddressData>({\r\n    fullName: user?.name || \"\",\r\n    phone: normalizePhone(user?.phone),\r\n    addressLine: \"\",\r\n    city: \"\",\r\n    state: \"\",\r\n    pincode: \"\",\r\n    latitude: undefined,\r\n    longitude: undefined,\r\n    isDefault: false,\r\n  });\r\n\r\n  const [isGettingLocation, setIsGettingLocation] = useState(false);\r\n\r\n  const [locationAccuracy, setLocationAccuracy] = useState<number | null>(null);\r\n\r\n  const [isLoading, setIsLoading] = useState(true);\r\n\r\n  const [isSubmitting, setIsSubmitting] = useState(false);\r\n  const [isSavingAddress, setIsSavingAddress] = useState(false);\r\n  const [checkoutError, setCheckoutError] = useState(\"\");\r\n  const submissionLockRef = useRef(false);\r\n  const addressSaveLockRef = useRef(false);\r\n  const autoPaymentStartedRef = useRef(false);\r\n\r\n  const getCheckoutItems = () => (cart?.items ?? []).flatMap((item) => {\r\n    const productId = typeof item.product === \"string\" ? item.product : item.product._id;\r\n    return productId && item.variantId ? [{ productId, variantId: item.variantId, quantity: item.quantity }] : [];\r\n  });\r\n  const refreshVerifiedSummary = async () => {\r\n    const response = await getCheckoutSummary(donationAmountSelected, getCheckoutItems());\r\n    if (response?.success && response.data) {\r\n      setCheckoutSummary(response.data);\r\n      setPriceChangesAccepted(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (!showAddressPicker) return;\r\n\r\n    const handleOutsideClick = (event: MouseEvent) => {\r\n      if (addressPickerRef.current && !addressPickerRef.current.contains(event.target as Node)) {\r\n        setShowAddressPicker(false);\r\n      }\r\n    };\r\n    const handleEscape = (event: KeyboardEvent) => {\r\n      if (event.key === \"Escape\") setShowAddressPicker(false);\r\n    };\r\n\r\n    document.addEventListener(\"mousedown\", handleOutsideClick);\r\n    document.addEventListener(\"keydown\", handleEscape);\r\n    return () => {\r\n      document.removeEventListener(\"mousedown\", handleOutsideClick);\r\n      document.removeEventListener(\"keydown\", handleEscape);\r\n    };\r\n  }, [showAddressPicker]);\r\n\r\n  // Validate local cart identifiers and quantities against current server prices and stock.\r\n  useEffect(() => {\r\n    if (!isCartReady) return;\r\n    let active = true;\r\n    setIsLoading(true);\r\n    setCart(localCart);\r\n    setCheckoutSummary(null);\r\n    setCheckoutError(\"\");\r\n    const lines = (localCart?.items ?? []).map((item) => ({ productId: typeof item.product === \"string\" ? item.product : item.product._id, variantId: item.variantId ?? \"\", quantity: item.quantity }));\r\n    if (lines.length === 0) {\r\n      setIsLoading(false);\r\n      return () => { active = false; };\r\n    }\r\n    getCheckoutSummary(donationAmountSelected, lines)\r\n      .then((response) => {\r\n        if (!active) return;\r\n        if (!response?.success || !response.data) throw new Error(response?.message || \"Unable to verify current prices and stock.\");\r\n        setCheckoutSummary(response.data);\r\n        setPriceChangesAccepted(false);\r\n      })\r\n      .catch((error: unknown) => {\r\n        if (!active) return;\r\n        console.error(\"Failed to validate checkout items:\", error);\r\n        const message = axios.isAxiosError(error) ? error.response?.data?.message || \"Unable to verify current prices and stock.\" : error instanceof Error ? error.message : \"Unable to verify current prices and stock.\";\r\n        setCheckoutError(message);\r\n      })\r\n      .finally(() => { if (active) setIsLoading(false); });\r\n    return () => { active = false; };\r\n  }, [donationAmountSelected, isCartReady, localCart]);\r\n\r\n  useEffect(() => {\r\n    let active = true;\r\n    getAddresses(1, 50).then((response) => {\r\n      if (!active) return;\r\n      const saved = (response.data || []) as Address[];\r\n      setAddresses(saved);\r\n      const requestedAddress = initialSelectedAddress || routeState?.selectedAddressId || (user?.id ? window.sessionStorage.getItem(`quickcart-selected-address:${user.id}`) || \"\" : \"\");\r\n      const validSelection = saved.find((address) => address._id === requestedAddress);\r\n      if (validSelection) setSelectedAddress(validSelection._id);\r\n      else {\r\n        setSelectedAddress(\"\");\r\n        if (requestedAddress && user?.id) window.sessionStorage.removeItem(`quickcart-selected-address:${user.id}`);\r\n      }\r\n    }).catch((error: unknown) => {\r\n      if (active) {\r\n        console.error(\"Failed to load checkout addresses:\", error);\r\n        setAddressError(\"Unable to load saved addresses.\");\r\n      }\r\n    });\r\n    return () => { active = false; };\r\n  }, [initialSelectedAddress, routeState?.selectedAddressId, user?.id]);\r\n\r\n  useEffect(() => {\r\n    onAddressChange?.(addresses.find((address) => address._id === selectedAddress));\r\n  }, [addresses, onAddressChange, selectedAddress]);\r\n\r\n  useEffect(() => {\r\n    if (user?.id && selectedAddress) window.sessionStorage.setItem(`quickcart-selected-address:${user.id}`, selectedAddress);\r\n  }, [selectedAddress, user?.id]);\r\n\r\n  const changedPrices = (checkoutSummary?.items ?? []).filter((verified) => {\r\n    const item = cart?.items.find((entry) => (typeof entry.product === \"string\" ? entry.product : entry.product._id) === verified.productId && entry.variantId === verified.variantId);\r\n    return item && Math.abs(getCartItemUnitPrice(item) - verified.sellingPrice) > 0.009;\r\n  });\r\n  const hasUnacceptedPriceChanges = changedPrices.length > 0 && !priceChangesAccepted;\r\n\r\n  /*\r\n   * Automatically detect the user's current location when the\r\n   * address form is opened. This matches the Blinkit-style flow:\r\n   * the map is immediately centered on the user's current position\r\n   * without requiring a second \"Go to current location\" click.\r\n   *\r\n   * IMPORTANT:\r\n   * - This only fills the address form.\r\n   * - It does NOT create/save an address automatically.\r\n   * - The user must still click \"Save Address\".\r\n   */\r\n  useEffect(() => {\r\n    if (isLoading || !showAddressForm || editingAddressId) {\r\n      return;\r\n    }\r\n\r\n    let cancelled = false;\r\n\r\n    const autoDetectLocation = async () => {\r\n      setIsGettingLocation(true);\r\n\r\n      try {\r\n        const detected = await detectCurrentLocation();\r\n\r\n        if (cancelled) {\r\n          return;\r\n        }\r\n\r\n        setAddressForm((previous) => ({\r\n          ...previous,\r\n          fullName: previous.fullName || user?.name || \"\",\r\n          phone: previous.phone || normalizePhone(user?.phone),\r\n          addressLine: detected.address.addressLine,\r\n          city: detected.address.city,\r\n          state: detected.address.state,\r\n          pincode: detected.address.pincode,\r\n          latitude: detected.latitude,\r\n          longitude: detected.longitude,\r\n          // The default-address decision is made when the\r\n          // user actually saves the address.\r\n          isDefault: false,\r\n        }));\r\n\r\n        setLocationAccuracy(detected.accuracy);\r\n      } catch (error) {\r\n        if (cancelled) {\r\n          return;\r\n        }\r\n\r\n        console.error(\"Automatic current location detection failed:\", error);\r\n\r\n        /*\r\n         * Do not close the form when permission is denied\r\n         * or location cannot be determined. The user can\r\n         * still manually enter the address or press the\r\n         * \"Detect My Location\" button again.\r\n         */\r\n      } finally {\r\n        if (!cancelled) {\r\n          setIsGettingLocation(false);\r\n        }\r\n      }\r\n    };\r\n\r\n    autoDetectLocation();\r\n\r\n    return () => {\r\n      cancelled = true;\r\n    };\r\n  }, [editingAddressId, isLoading, showAddressForm, user?.name, user?.phone]);\r\n\r\n  const handleGetCurrentLocation = async () => {\r\n    try {\r\n      setIsGettingLocation(true);\r\n\r\n      const detected = await detectCurrentLocation();\r\n\r\n      // Manual detection also only fills the form.\r\n      // It does not save anything until Save Address is clicked.\r\n      const formData: CreateAddressData = {\r\n        fullName: user?.name || \"\",\r\n        phone: normalizePhone(user?.phone),\r\n        addressLine: detected.address.addressLine,\r\n        city: detected.address.city,\r\n        state: detected.address.state,\r\n        pincode: detected.address.pincode,\r\n        latitude: detected.latitude,\r\n        longitude: detected.longitude,\r\n        isDefault: addresses.length === 0,\r\n      };\r\n\r\n      // Detection only fills the form.\r\n      // The address is saved only when the\r\n      // user clicks \"Save Address\".\r\n      setAddressForm(formData);\r\n\r\n      setLocationAccuracy(detected.accuracy);\r\n\r\n      setShowAddressForm(true);\r\n    } catch (error) {\r\n      console.error(\"Get current location error:\", error);\r\n\r\n      alert(\r\n        error instanceof Error\r\n          ? error.message\r\n          : \"Unable to get your current location.\",\r\n      );\r\n    } finally {\r\n      setIsGettingLocation(false);\r\n    }\r\n  };\r\n\r\n  const handleMapLocationChange = (\r\n    detected: Awaited<ReturnType<typeof detectCurrentLocation>>,\r\n  ) => {\r\n    setAddressForm((previous) => ({\r\n      ...previous,\r\n      addressLine: detected.address.addressLine,\r\n      city: detected.address.city,\r\n      state: detected.address.state,\r\n      pincode: detected.address.pincode,\r\n      latitude: detected.latitude,\r\n      longitude: detected.longitude,\r\n      isDefault: false,\r\n    }));\r\n\r\n    // The map location is manually selected, so GPS accuracy is no\r\n    // longer the relevant value. The address text itself is updated\r\n    // immediately after reverse geocoding finishes.\r\n    setLocationAccuracy(null);\r\n  };\r\n\r\n  const handleAddressChange = (event: React.ChangeEvent<HTMLInputElement>) => {\r\n    const { name, value } = event.target;\r\n\r\n    if (name === \"phone\") {\r\n      const phone = value.replace(/\\D/g, \"\").slice(0, 10);\r\n\r\n      setAddressForm((previous) => ({\r\n        ...previous,\r\n        phone,\r\n      }));\r\n\r\n      return;\r\n    }\r\n\r\n    setAddressForm((previous) => ({\r\n      ...previous,\r\n      [name]: value,\r\n    }));\r\n  };\r\n\r\n  const startEditingAddress = (address: Address) => {\r\n    setEditingAddressId(address._id);\r\n    setAddressForm({\r\n      fullName: address.fullName,\r\n      phone: normalizePhone(address.phone),\r\n      addressLine: address.addressLine,\r\n      city: address.city,\r\n      state: address.state,\r\n      pincode: address.pincode,\r\n      latitude: address.latitude,\r\n      longitude: address.longitude,\r\n      isDefault: address.isDefault,\r\n    });\r\n    setShowAddressPicker(false);\r\n    setShowAddressForm(true);\r\n  };\r\n\r\n  const handleCreateAddress = async (\r\n    event: React.FormEvent<HTMLFormElement>,\r\n  ) => {\r\n    event.preventDefault();\r\n    if (addressSaveLockRef.current) return;\r\n\r\n    if (!/^\\d{10}$/.test(addressForm.phone)) {\r\n      const message = \"Phone number must be exactly 10 digits.\";\r\n      if (embedded) setCheckoutError(message);\r\n      else alert(message);\r\n      return;\r\n    }\r\n\r\n    addressSaveLockRef.current = true;\r\n    setIsSavingAddress(true);\r\n    try {\r\n      const dataToSave: CreateAddressData = {\r\n        ...addressForm,\r\n        isDefault: addressForm.isDefault || addresses.length === 0,\r\n      };\r\n\r\n      const response = editingAddressId\r\n        ? await updateAddress(editingAddressId, dataToSave)\r\n        : await createAddress(dataToSave);\r\n\r\n      const newAddress = response.data as Address;\r\n\r\n      setAddresses((previous) => editingAddressId\r\n        ? previous.map((address) => address._id === editingAddressId ? newAddress : address)\r\n        : [...previous, newAddress]);\r\n\r\n      setSelectedAddress(newAddress._id);\r\n      setEditingAddressId(\"\");\r\n      setShowAddressPicker(false);\r\n\r\n      setShowAddressForm(false);\r\n\r\n      setAddressForm({\r\n        fullName: user?.name || \"\",\r\n        phone: normalizePhone(user?.phone),\r\n        addressLine: \"\",\r\n        city: \"\",\r\n        state: \"\",\r\n        pincode: \"\",\r\n        latitude: undefined,\r\n        longitude: undefined,\r\n        isDefault: false,\r\n      });\r\n\r\n      setLocationAccuracy(null);\r\n      setCheckoutError(\"\");\r\n    } catch (error) {\r\n      console.error(\"Failed to create address:\", error);\r\n      const message = axios.isAxiosError(error)\r\n        ? error.response?.data?.message || \"Failed to save address.\"\r\n        : error instanceof Error ? error.message : \"Failed to save address.\";\r\n      if (embedded) setCheckoutError(message);\r\n      else alert(message);\r\n    } finally {\r\n      addressSaveLockRef.current = false;\r\n      setIsSavingAddress(false);\r\n    }\r\n  };\r\n\r\n  const handleCodOrder = async () => {\r\n    try {\r\n      setIsSubmitting(true);\r\n      const orderedItems = getCheckoutItems();\r\n      const expectedTotal = checkoutSummary?.totalAmount;\r\n      const response = await createOrder(selectedAddress, \"COD\", donationAmountSelected, orderedItems, expectedTotal);\r\n      const confirmedOrder = getConfirmedOrder<Order>(response, \"The order was not confirmed. Your cart is unchanged.\");\r\n      await removePurchasedItems(orderedItems);\r\n      if (embedded && onOrderSuccess) {\r\n        onOrderSuccess(confirmedOrder, addresses.find((address) => address._id === selectedAddress));\r\n      } else {\r\n        if (user?.id) window.sessionStorage.removeItem(`quickcart-cart-donation:${user.id}`);\r\n        navigate(\"/order-confirmation\");\r\n      }\r\n      setCheckoutError(\"\");\r\n    } catch (error) {\r\n      console.error(\"Failed to place COD order:\", error);\r\n      if (axios.isAxiosError(error) && error.response?.status === 409) {\r\n        try { await refreshVerifiedSummary(); } catch (refreshError) { console.error(\"Unable to refresh checkout prices:\", refreshError); }\r\n      }\r\n      const message = axios.isAxiosError(error)\r\n        ? error.response?.data?.message || \"Failed to place order.\"\r\n        : error instanceof Error ? error.message : \"Failed to place order.\";\r\n      if (embedded) setCheckoutError(message);\r\n      else alert(message);\r\n    } finally {\r\n      setIsSubmitting(false);\r\n      submissionLockRef.current = false;\r\n    }\r\n  };\r\n\r\n  const handleRazorpayPayment = async () => {\r\n    try {\r\n      setIsSubmitting(true);\r\n      const orderedItems = getCheckoutItems();\r\n      const expectedTotal = checkoutSummary?.totalAmount;\r\n\r\n      const isLoaded = await loadRazorpayScript();\r\n\r\n      if (!isLoaded) {\r\n        throw new Error(\"Unable to load Razorpay Checkout.\");\r\n      }\r\n\r\n      const response = await createRazorpayOrder(selectedAddress, donationAmountSelected, orderedItems, expectedTotal);\r\n\r\n      if (!response?.success || !response?.data) {\r\n        throw new Error(\r\n          response?.message || \"Failed to create Razorpay order.\",\r\n        );\r\n      }\r\n\r\n      const { keyId, razorpayOrderId, amount, currency } = response.data;\r\n\r\n      const selectedAddressData = addresses.find(\r\n        (address) => address._id === selectedAddress,\r\n      );\r\n\r\n      const razorpay = new window.Razorpay({\r\n        key: keyId,\r\n        amount,\r\n        currency,\r\n        name: \"QuickCart\",\r\n        description: \"QuickCart Order\",\r\n        order_id: razorpayOrderId,\r\n        prefill: {\r\n          name: selectedAddressData?.fullName,\r\n          contact: selectedAddressData?.phone,\r\n          email: user?.email,\r\n        },\r\n        theme: {\r\n          color: colors.primary,\r\n        },\r\n        handler: async (paymentResponse) => {\r\n          try {\r\n            const verified = await verifyRazorpayPayment({\r\n              addressId: selectedAddress,\r\n              razorpayPaymentId: paymentResponse.razorpay_payment_id,\r\n              razorpayOrderId: paymentResponse.razorpay_order_id,\r\n              razorpaySignature: paymentResponse.razorpay_signature,\r\n              donationSelected: donationAmountSelected,\r\n              items: orderedItems,\r\n              expectedTotal,\r\n            });\r\n            const confirmedOrder = getConfirmedOrder<Order>(verified, \"Payment was not verified. Your cart is unchanged.\");\r\n            await removePurchasedItems(orderedItems);\r\n\r\n            if (embedded && onOrderSuccess) {\r\n              onOrderSuccess(confirmedOrder, selectedAddressData);\r\n            } else {\r\n              if (user?.id) window.sessionStorage.removeItem(`quickcart-cart-donation:${user.id}`);\r\n              navigate(\"/order-confirmation\");\r\n            }\r\n            setCheckoutError(\"\");\r\n          } catch (error) {\r\n            console.error(\"Razorpay verification failed:\", error);\r\n            const message = axios.isAxiosError(error)\r\n              ? error.response?.data?.message || \"Payment verification failed.\"\r\n              : error instanceof Error ? error.message : \"Payment verification failed.\";\r\n            if (embedded) setCheckoutError(message);\r\n            else alert(message);\r\n          } finally {\r\n            setIsSubmitting(false);\r\n            submissionLockRef.current = false;\r\n          }\r\n        },\r\n        modal: {\r\n          ondismiss: () => {\r\n            setIsSubmitting(false);\r\n            submissionLockRef.current = false;\r\n          },\r\n        },\r\n      });\r\n\r\n      razorpay.open();\r\n    } catch (error) {\r\n      console.error(\"Razorpay payment error:\", error);\r\n      if (axios.isAxiosError(error) && error.response?.status === 409) {\r\n        try { await refreshVerifiedSummary(); } catch (refreshError) { console.error(\"Unable to refresh checkout prices:\", refreshError); }\r\n      }\r\n      const message = axios.isAxiosError(error)\r\n        ? error.response?.data?.message || \"Unable to start Razorpay payment.\"\r\n        : error instanceof Error ? error.message : \"Unable to start Razorpay payment.\";\r\n      if (embedded) setCheckoutError(message);\r\n      else alert(message);\r\n\r\n      setIsSubmitting(false);\r\n      submissionLockRef.current = false;\r\n    }\r\n  };\r\n\r\n  const handlePlaceOrder = async () => {\r\n    if (submissionLockRef.current) return;\r\n    if (!selectedAddress) {\r\n      setCheckoutError(\"Please select a delivery address.\");\r\n      return;\r\n    }\r\n\r\n    if (!cart || cart.items.length === 0) {\r\n      setCheckoutError(\"Your cart is empty.\");\r\n      return;\r\n    }\r\n    if (hasUnacceptedPriceChanges) {\r\n      setCheckoutError(\"Review and accept the updated item prices before continuing.\");\r\n      return;\r\n    }\r\n    if (!checkoutSummary) {\r\n      setCheckoutError(\"Checkout prices are still being verified. Please try again shortly.\");\r\n      return;\r\n    }\r\n\r\n    setCheckoutError(\"\");\r\n    submissionLockRef.current = true;\r\n    if (paymentMethod === \"COD\") {\r\n      await handleCodOrder();\r\n      return;\r\n    }\r\n\r\n    await handleRazorpayPayment();\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (!autoStartPayment || autoPaymentStartedRef.current || isLoading || hasUnacceptedPriceChanges || !checkoutSummary || !cart?.items.length || !selectedAddress) return;\r\n    autoPaymentStartedRef.current = true;\r\n    submissionLockRef.current = true;\r\n    void handleRazorpayPayment();\r\n  }, [autoStartPayment, cart, checkoutSummary, hasUnacceptedPriceChanges, isLoading, selectedAddress]);\r\n\r\n  if (isLoading) {\r\n    return <div className=\"checkout-message\">Loading checkout...</div>;\r\n  }\r\n\r\n  if (!cart || cart.items.length === 0) {\r\n    return (\r\n      <div className=\"checkout-message\">\r\n        <h2>Your cart is empty.</h2>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  const cartSubtotal = getCartSubtotal(cart.items) ?? 0;\r\n  const subtotal = checkoutSummary?.subtotal ?? cartSubtotal;\r\n  const shippingAmount = checkoutSummary?.shippingAmount;\r\n  const total = checkoutSummary?.totalAmount;\r\n  const selectedAddressData = addresses.find(\r\n    (address) => address._id === selectedAddress,\r\n  );\r\n\r\n  return (\r\n    <div className={`checkout-page${embedded ? \" checkout-page--drawer\" : \"\"}`}>\r\n      <div className=\"checkout-container\">\r\n        <div className=\"checkout-heading\">\r\n          {embedded && onBack && (\r\n            <button type=\"button\" className=\"checkout-back-button\" onClick={onBack} aria-label=\"Back to cart\">←</button>\r\n          )}\r\n          {!embedded && <h1>Select Payment Method</h1>}\r\n          {embedded && <div><p><button type=\"button\" className=\"checkout-brand\" onClick={() => navigate(\"/\")}>QuickCart</button></p><h1>Checkout</h1></div>}\r\n        </div>\r\n\r\n        {checkoutError && <p className=\"checkout-flow-error\" role=\"alert\">{checkoutError}</p>}\r\n\r\n        <div className=\"checkout-layout\">\r\n          <div className=\"checkout-main\">\r\n            <section className=\"checkout-section\">\r\n              <div className=\"checkout-section-header\">\r\n                <h2>Delivery Address</h2>\r\n\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => {\r\n                    setShowAddressForm((previous) => !previous);\r\n                    setShowAddressPicker(false);\r\n                    setEditingAddressId(\"\");\r\n                    setAddressForm({\r\n                      fullName: user?.name || \"\",\r\n                      phone: normalizePhone(user?.phone),\r\n                      addressLine: \"\",\r\n                      city: \"\",\r\n                      state: \"\",\r\n                      pincode: \"\",\r\n                      latitude: undefined,\r\n                      longitude: undefined,\r\n                      isDefault: addresses.length === 0,\r\n                    });\r\n                  }}\r\n                >\r\n                  {showAddressForm ? \"Cancel\" : \"+ Add Address\"}\r\n                </button>\r\n              </div>\r\n\r\n              {selectedAddressData ? (\r\n                <div className=\"selected-address-summary\">\r\n                  <strong>{selectedAddressData.fullName}</strong>\r\n                  <span>\r\n                    {selectedAddressData.addressLine}, {selectedAddressData.city},{\" \"}\r\n                    {selectedAddressData.state} - {selectedAddressData.pincode}\r\n                  </span>\r\n                  <small>{selectedAddressData.phone}</small>\r\n                </div>\r\n              ) : (\r\n                <p className=\"no-selected-address\">\r\n                  No delivery address selected. Add or choose an address to continue.\r\n                </p>\r\n              )}\r\n\r\n              <div className=\"address-picker\" ref={addressPickerRef}>\r\n                <button\r\n                  type=\"button\"\r\n                  className=\"change-address-button\"\r\n                  onClick={() => {\r\n                    setShowAddressPicker((previous) => !previous);\r\n                    setShowAddressForm(false);\r\n                  }}\r\n                  aria-expanded={showAddressPicker}\r\n                >\r\n                  {showAddressPicker ? \"Close Address List\" : \"Change Delivery Address\"}\r\n                </button>\r\n\r\n                {showAddressPicker && (\r\n                  <div className=\"address-list address-picker-panel\">\r\n                    {addressError ? (\r\n                      <p className=\"address-picker-message error\">{addressError}</p>\r\n                    ) : addresses.length === 0 ? (\r\n                      <div className=\"address-picker-message\">\r\n                        <p>No saved address found.</p>\r\n                        <button\r\n                          type=\"button\"\r\n                          onClick={() => {\r\n                            setShowAddressPicker(false);\r\n                            setShowAddressForm(true);\r\n                          }}\r\n                        >\r\n                          Add Address\r\n                        </button>\r\n                      </div>\r\n                    ) : (\r\n                      addresses.map((address) => (\r\n                        <div\r\n                          key={address._id}\r\n                          className={`address-card compact-address-card ${\r\n                            selectedAddress === address._id ? \"selected\" : \"\"\r\n                          }`}\r\n                        >\r\n                          <input\r\n                            type=\"radio\"\r\n                            name=\"address\"\r\n                            value={address._id}\r\n                            checked={selectedAddress === address._id}\r\n                            onChange={() => {\r\n                              setSelectedAddress(address._id);\r\n                              setShowAddressPicker(false);\r\n                            }}\r\n                          />\r\n                          <div>\r\n                            <strong>{address.isDefault ? \"Home\" : \"Saved address\"}</strong>\r\n                            <span className=\"checkout-address-name\">{address.fullName}</span>\r\n                            <p>\r\n                              {address.addressLine}, {address.city}, {address.state} -{\" \"}\r\n                              {address.pincode}\r\n                            </p>\r\n                            <span>{address.phone}</span>\r\n                          </div>\r\n                          <button type=\"button\" className=\"checkout-address-edit\" onClick={() => startEditingAddress(address)}>Edit</button>\r\n                        </div>\r\n                      ))\r\n                    )}\r\n                  </div>\r\n                )}\r\n              </div>\r\n\r\n              {showAddressForm && (\r\n                <form className=\"address-form\" onSubmit={handleCreateAddress}>\r\n                  <AddressMap\r\n                    latitude={addressForm.latitude}\r\n                    longitude={addressForm.longitude}\r\n                    onDetectLocation={handleGetCurrentLocation}\r\n                    onLocationChange={handleMapLocationChange}\r\n                    isDetecting={isGettingLocation}\r\n                  />\r\n\r\n                  <button\r\n                    type=\"button\"\r\n                    className=\"current-location-button\"\r\n                    onClick={handleGetCurrentLocation}\r\n                    disabled={isGettingLocation}\r\n                  >\r\n                    {isGettingLocation\r\n                      ? \"Detecting...\"\r\n                      : \"📍 Detect My Location\"}\r\n                  </button>\r\n\r\n                  {addressForm.latitude !== undefined &&\r\n                    addressForm.longitude !== undefined && (\r\n                      <div className=\"location-captured\">\r\n                        <strong>✓ Delivery location selected</strong>\r\n\r\n                        {addressForm.addressLine && (\r\n                          <span>{addressForm.addressLine}</span>\r\n                        )}\r\n\r\n                        <small>\r\n                          {addressForm.city}\r\n                          {addressForm.state ? `, ${addressForm.state}` : \"\"}\r\n                          {addressForm.pincode\r\n                            ? ` - ${addressForm.pincode}`\r\n                            : \"\"}\r\n                        </small>\r\n\r\n                        {locationAccuracy !== null && locationAccuracy > 0 && (\r\n                          <small>\r\n                            GPS accuracy: approximately{\" \"}\r\n                            {Math.round(locationAccuracy)}m\r\n                          </small>\r\n                        )}\r\n                      </div>\r\n                    )}\r\n\r\n                  <input\r\n                    name=\"fullName\"\r\n                    placeholder=\"Full Name\"\r\n                    value={addressForm.fullName}\r\n                    onChange={handleAddressChange}\r\n                    required\r\n                  />\r\n\r\n                  <input\r\n                    type=\"tel\"\r\n                    name=\"phone\"\r\n                    placeholder=\"Phone\"\r\n                    value={addressForm.phone}\r\n                    maxLength={10}\r\n                    inputMode=\"numeric\"\r\n                    onChange={handleAddressChange}\r\n                    required\r\n                  />\r\n\r\n                  <input\r\n                    name=\"addressLine\"\r\n                    placeholder=\"Address\"\r\n                    value={addressForm.addressLine}\r\n                    onChange={handleAddressChange}\r\n                    required\r\n                  />\r\n\r\n                  <div className=\"address-form-row\">\r\n                    <input\r\n                      name=\"city\"\r\n                      placeholder=\"City\"\r\n                      value={addressForm.city}\r\n                      onChange={handleAddressChange}\r\n                      required\r\n                    />\r\n\r\n                    <input\r\n                      name=\"state\"\r\n                      placeholder=\"State\"\r\n                      value={addressForm.state}\r\n                      onChange={handleAddressChange}\r\n                      required\r\n                    />\r\n\r\n                    <input\r\n                      name=\"pincode\"\r\n                      placeholder=\"Pincode\"\r\n                      value={addressForm.pincode}\r\n                      onChange={handleAddressChange}\r\n                      required\r\n                    />\r\n                  </div>\r\n\r\n                  <button type=\"submit\" disabled={isSavingAddress}>{isSavingAddress ? \"Saving address…\" : editingAddressId ? \"Save changes\" : \"Save Address\"}</button>\r\n                </form>\r\n              )}\r\n\r\n            </section>\r\n\r\n            <section className=\"checkout-section\">\r\n              <h2>Payment Method</h2>\r\n\r\n              <label className=\"payment-option\">\r\n                <input\r\n                  type=\"radio\"\r\n                  checked={paymentMethod === \"COD\"}\r\n                  onChange