rom React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nD:\\QuickCart\\client\\src\\pages\\admin\\AdminBanners.tsx:125:23\n  123 |\n  124 |   useEffect(() => {\n> 125 |     void Promise.all([fetchBanners(), fetchRedirectOptions()]);\n      |                       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  126 |     }, [page]);\n  127 |\n  128 |   const resetForm = () => {","line":125,"column":23,"endLine":125,"endColumn":35},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchBanners'. Either include it or remove the dependency array.","line":126,"column":8,"endLine":126,"endColumn":14,"suggestions":[{"desc":"Update the dependencies array to be: [fetchBanners, page]","fix":{"range":[3926,3932],"text":"[fetchBanners, page]"}}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useDialogFocus } from \"../../hooks/useDialogFocus\";\nimport { useEffect, useState } from \"react\";\nimport type { FormEvent } from \"react\";\nimport axios from \"axios\";\n\nimport {\n  createAdminBanner,\n  deleteAdminBanner,\n  getAdminBanners,\n  toggleAdminBannerStatus,\n  updateAdminBanner,\n} from \"../../services/bannerService\";\nimport { getAdminCategories, getAdminProducts } from \"../../services/adminService\";\nimport type { Banner, BannerRedirectType } from \"../../types/banner\";\nimport type { Category, Product } from \"../../types/product\";\nimport Pagination from \"../../components/common/Pagination\";\n\nimport \"./AdminBanners.css\";\n\nconst ALLOWED_IMAGE_TYPES = [\n  \"image/jpeg\",\n  \"image/png\",\n  \"image/webp\",\n  \"image/jpg\",\n];\n\nconst MAX_IMAGE_SIZE = 5 * 1024 * 1024;\n\ntype BannerFormState = {\n  redirectType: BannerRedirectType;\n  redirectValue: string;\n  order: string;\n  isActive: boolean;\n  startDate: string;\n  endDate: string;\n};\n\nconst initialForm: BannerFormState = {\n  redirectType: \"category\",\n  redirectValue: \"\",\n  order: \"0\",\n  isActive: true,\n  startDate: \"\",\n  endDate: \"\",\n};\n\nconst toDateInputValue = (value?: string) => {\n  if (!value) return \"\";\n\n  const date = new Date(value);\n  if (Number.isNaN(date.getTime())) return \"\";\n\n  const year = date.getFullYear();\n  const month = String(date.getMonth() + 1).padStart(2, \"0\");\n  const day = String(date.getDate()).padStart(2, \"0\");\n\n  return `${year}-${month}-${day}`;\n};\n\nconst AdminBanners = () => {\n  const [banners, setBanners] = useState<Banner[]>([]);\n  const [categories, setCategories] = useState<Category[]>([]);\n  const [products, setProducts] = useState<Product[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [busyBannerId, setBusyBannerId] = useState<string | null>(null);\n\n  const [showForm, setShowForm] = useState(false);\n  const [editingBanner, setEditingBanner] = useState<Banner | null>(null);\n  const [form, setForm] = useState<BannerFormState>(initialForm);\n  const [imageFile, setImageFile] = useState<File | null>(null);\n  const [imagePreview, setImagePreview] = useState(\"\");\n\n  const [error, setError] = useState(\"\");\n  const [success, setSuccess] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [totalPages, setTotalPages] = useState(1);\n  const [totalItems, setTotalItems] = useState(0);\n\n  const isEditing = Boolean(editingBanner);\n\n  const fetchBanners = async (requestedPage = page) => {\n    try {\n      setIsLoading(true);\n      setError(\"\");\n\n      const response = await getAdminBanners(requestedPage, 10);\n\n      if (response?.success) {\n        setBanners(response.data || []);\n        setTotalPages(response.pagination?.totalPages || 1);\n        if (requestedPage > (response.pagination?.totalPages || 1)) setPage(response.pagination?.totalPages || 1);\n        setTotalItems(response.pagination?.totalItems || 0);\n      } else {\n        setError(\"Failed to load banners.\");\n      }\n    } catch (error: unknown) {\n      console.error(\"Get admin banners error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(error.response?.data?.message || \"Failed to load banners.\");\n      } else {\n        setError(\"Failed to load banners.\");\n      }\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const fetchRedirectOptions = async () => {\n    try {\n      const [categoryResponse, productResponse] = await Promise.all([\n        getAdminCategories(1, 100),\n        getAdminProducts(1, 100),\n      ]);\n      if (categoryResponse?.success) setCategories(categoryResponse.data || []);\n      if (productResponse?.success) setProducts(productResponse.data || []);\n    } catch (error) {\n      console.error(\"Get banner redirect options error:\", error);\n      setError(\"Failed to load banner redirect options.\");\n    }\n  };\n\n  useEffect(() => {\n    void Promise.all([fetchBanners(), fetchRedirectOptions()]);\n    }, [page]);\n\n  const resetForm = () => {\n    setShowForm(false);\n    setEditingBanner(null);\n    setForm(initialForm);\n    setImageFile(null);\n    setImagePreview(\"\");\n  };\n\n  const openAddForm = () => {\n    setError(\"\");\n    setSuccess(\"\");\n    setEditingBanner(null);\n    setForm(initialForm);\n    setImageFile(null);\n    setImagePreview(\"\");\n    setShowForm(true);\n  };\n\n  const openEditForm = (banner: Banner) => {\n    setError(\"\");\n    setSuccess(\"\");\n    setEditingBanner(banner);\n    setForm({\n      redirectType: banner.redirectType === \"product\" ? \"product\" : \"category\",\n      redirectValue: banner.redirectValue || \"\",\n      order: String(banner.order ?? 0),\n      isActive: banner.isActive,\n      startDate: toDateInputValue(banner.startDate),\n      endDate: toDateInputValue(banner.endDate),\n    });\n    setImageFile(null);\n    setImagePreview(banner.image || \"\");\n    setShowForm(true);\n  };\n\n  const handleImageChange = (file: File | null) => {\n    setError(\"\");\n\n    if (!file) {\n      setImageFile(null);\n      if (editingBanner) {\n        setImagePreview(editingBanner.image || \"\");\n      } else {\n        setImagePreview(\"\");\n      }\n      return;\n    }\n\n    if (!ALLOWED_IMAGE_TYPES.includes(file.type)) {\n      setError(\"Only JPG, JPEG, PNG and WEBP images are allowed.\");\n      return;\n    }\n\n    if (file.size > MAX_IMAGE_SIZE) {\n      setError(\"Banner image must be 5 MB or smaller.\");\n      return;\n    }\n\n    setImageFile(file);\n    setImagePreview(URL.createObjectURL(file));\n  };\n\n  const handleFormChange = (\n    field: keyof BannerFormState,\n    value: string | boolean,\n  ) => {\n    setForm((previous) => ({ ...previous, [field]: value }));\n  };\n\n  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n\n    if (!isEditing && !imageFile) {\n      setError(\"Please upload a banner image.\");\n      return;\n    }\n\n    if (!form.redirectValue) {\n      setError(\"Please select a banner destination.\");\n      return;\n    }\n\n    if (\n      form.startDate &&\n      form.endDate &&\n      new Date(form.endDate) < new Date(form.startDate)\n    ) {\n      setError(\"End date cannot be earlier than start date.\");\n      return;\n    }\n\n    try {\n      setIsSubmitting(true);\n      setError(\"\");\n      setSuccess(\"\");\n\n      const formData = new FormData();\n      formData.append(\"redirectType\", form.redirectType);\n      formData.append(\"redirectValue\", form.redirectValue);\n      formData.append(\"order\", form.order || \"0\");\n      formData.append(\"isActive\", String(form.isActive));\n      formData.append(\n        \"startDate\",\n        form.startDate\n          ? new Date(`${form.startDate}T00:00:00`).toISOString()\n          : \"\",\n      );\n      formData.append(\n        \"endDate\",\n        form.endDate\n          ? new Date(`${form.endDate}T23:59:59.999`).toISOString()\n          : \"\",\n      );\n\n      if (imageFile) {\n        formData.append(\"image\", imageFile);\n      }\n\n      const response =\n        isEditing && editingBanner\n          ? await updateAdminBanner(editingBanner._id, formData)\n          : await createAdminBanner(formData);\n\n      if (!response?.success) {\n        throw new Error(\n          response?.message ||\n            `Failed to ${isEditing ? \"update\" : \"create\"} banner.`,\n        );\n      }\n\n      await fetchBanners();\n      resetForm();\n      setSuccess(\n        isEditing\n          ? \"Banner updated successfully.\"\n          : \"Banner created successfully.\",\n      );\n    } catch (error: unknown) {\n      console.error(\"Save banner error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(\n          error.response?.data?.message ||\n            `Failed to ${isEditing ? \"update\" : \"create\"} banner.`,\n        );\n      } else {\n        setError(\n          error instanceof Error\n            ? error.message\n            : `Failed to ${isEditing ? \"update\" : \"create\"} banner.`,\n        );\n      }\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const handleDelete = async (banner: Banner) => {\n    const confirmed = window.confirm(\n      \"Delete this banner? This action cannot be undone.\",\n    );\n\n    if (!confirmed) return;\n\n    try {\n      setBusyBannerId(banner._id);\n      setError(\"\");\n      setSuccess(\"\");\n\n      const response = await deleteAdminBanner(banner._id);\n\n      if (!response?.success) {\n        throw new Error(response?.message || \"Failed to delete banner.\");\n      }\n\n      setBanners((previous) =>\n        previous.filter((item) => item._id !== banner._id),\n      );\n      setSuccess(\"Banner deleted successfully.\");\n    } catch (error: unknown) {\n      console.error(\"Delete banner error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(error.response?.data?.message || \"Failed to delete banner.\");\n      } else {\n        setError(\n          error instanceof Error ? error.message : \"Failed to delete banner.\",\n        );\n      }\n    } finally {\n      setBusyBannerId(null);\n    }\n  };\n\n  const handleToggleStatus = async (banner: Banner) => {\n    try {\n      setBusyBannerId(banner._id);\n      setError(\"\");\n      setSuccess(\"\");\n\n      const response = await toggleAdminBannerStatus(banner._id);\n\n      if (!response?.success) {\n        throw new Error(response?.message || \"Failed to update banner status.\");\n      }\n\n      const nextIsActive = response.data?.isActive ?? !banner.isActive;\n\n      setBanners((previous) =>\n        previous.map((item) => ({\n          ...item,\n          isActive: nextIsActive ? item._id === banner._id : item._id === banner._id\n            ? false\n            : item.isActive,\n        })),\n      );\n      setSuccess(response.message || \"Banner status updated successfully.\");\n    } catch (error: unknown) {\n      console.error(\"Toggle banner status error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(\n          error.response?.data?.message || \"Failed to update banner status.\",\n        );\n      } else {\n        setError(\n          error instanceof Error\n            ? error.message\n            : \"Failed to update banner status.\",\n        );\n      }\n    } finally {\n      setBusyBannerId(null);\n    }\n  };\n\n  const dialogFocus = useDialogFocus<HTMLDivElement>(showForm && !isLoading, () => { if (!isSubmitting) resetForm(); });\n\n  if (isLoading) {\n    return (\n      <div className=\"admin-banners-page\">\n        <div className=\"admin-banners-loading\">Loading banners...</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"admin-banners-page\">\n      <div className=\"admin-banners-container\">\n        <div className=\"admin-banners-header\">\n          <div>\n            <span className=\"admin-banners-eyebrow\">HOME PAGE CONTENT</span>\n            <h1>Manage Banners</h1>\n            <p>\n              Create promotional banners and control what customers see on the\n              QuickCart home page.\n            </p>\n          </div>\n\n          <button\n            type=\"button\"\n            className=\"admin-banner-add-button\"\n            onClick={openAddForm}\n          >\n            + Add Banner\n          </button>\n        </div>\n\n        {error && <div className=\"admin-banner-message error\">{error}</div>}\n        {success && (\n          <div className=\"admin-banner-message success\">{success}</div>\n        )}\n\n        {showForm && (\n          <div\n            {...dialogFocus}\n            className=\"admin-banner-modal-overlay\"\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-labelledby=\"admin-banner-modal-title\"\n            onMouseDown={(event) => {\n              if (event.target === event.currentTarget && !isSubmitting) {\n                resetForm();\n              }\n            }}\n          >\n            <div className=\"admin-banner-form-card\">\n              <div className=\"admin-banner-form-header\">\n                <div>\n                  <span className=\"admin-banners-eyebrow\">BANNER EDITOR</span>\n                  <h2 id=\"admin-banner-modal-title\">\n                    {isEditing ? \"Edit Banner\" : \"Add New Banner\"}\n                  </h2>\n                  <p>\n                    Upload an image and control its display schedule.\n                  </p>\n                </div>\n\n                <button\n                  type=\"button\"\n                  className=\"admin-banner-close-button\"\n                  onClick={resetForm}\n                  disabled={isSubmitting}\n                  aria-label=\"Close\"\n                >\n                  Ã—\n                </button>\n              </div>\n\n              <form className=\"admin-banner-form\" onSubmit={handleSubmit}>\n                <div className=\"admin-banner-form-grid\">\n                  <label className=\"full-width\">\n                    Banner Image\n                    <input\n                      type=\"file\"\n                      accept=\"image/jpeg,image/png,image/webp,image/jpg\"\n                      onChange={(event) =>\n                        handleImageChange(event.target.files?.[0] || null)\n                      }\n                      disabled={isSubmitting}\n                    />\n                    <small>\n                      JPG, JPEG, PNG or WEBP. Maximum 5 MB. Recommended: 1280\n                      Ã— 272 px (4.71:1) for the homepage hero.\n                    </small>\n                  </label>\n\n                  {imagePreview && (\n                    <div className=\"admin-banner-preview full-width\">\n                      <img src={imagePreview} alt=\"Banner preview\" />\n                    </div>\n                  )}\n\n                  <label>\n                    Redirect Type\n                    <select\n                      value={form.redirectType}\n                      onChange={(event) =>\n                        setForm((previous) => ({\n                          ...previous,\n                          redirectType: event.target.value as BannerRedirectType,\n                          redirectValue: \"\",\n                        }))\n                      }\n                      disabled={isSubmitting}\n                    >\n                      <option value=\"category\">Category</option>\n                      <option value=\"product\">Product</option>\n                    </select>\n                  </label>\n\n                  <label>\n                    Redirect Target\n                    <select\n                      value={form.redirectValue}\n                      onChange={(event) =>\n                        handleFormChange(\"redirectValue\", event.target.value)\n                      }\n                      disabled={isSubmitting}\n                      required\n                    >\n                      <option value=\"\">\n                        Select {form.redirectType}\n                      </option>\n                      {form.redirectType === \"category\"\n                        ? categories.map((category) => (\n                            <option key={category._id} value={category._id}>\n                              {category.name}\n                            </option>\n                          ))\n                        : products.map((product) => (\n                            <option key={product._id} value={product._id}>\n                              {product.name} - from {String.fromCharCode(0x20b9)}{Math.min(...(product.variants ?? []).filter((variant) => variant.isActive).map((variant) => variant.discountPrice ?? variant.price))}\n                            </option>\n                          ))}\n                    </select>\n                  </label>\n\n                  <label>\n                    Display Order\n                    <input\n                      type=\"number\"\n                      min=\"0\"\n                      step=\"1\"\n                      value={form.order}\n                      onChange={(event) =>\n                        handleFormChange(\"order\", event.target.value)\n                      }\n                      disabled={isSubmitting}\n                    />\n                    <small>Lower numbers appear first.</small>\n                  </label>\n\n                  <label>\n                    Active\n                    <span className=\"admin-banner-checkbox-row\">\n                      <input\n                        type=\"checkbox\"\n                        checked={form.isActive}\n                        onChange={(event) =>\n                          handleFormChange(\"isActive\", event.target.checked)\n                        }\n                        disabled={isSubmitting}\n                      />\n                      Show this banner on the Home Page\n                    </span>\n                  </label>\n\n                  <label>\n                    Start Date\n                    <input\n                      type=\"date\"\n                      value={form.startDate}\n                      onChange={(event) =>\n                        handleFormChange(\"startDate\", event.target.value)\n                      }\n                      disabled={isSubmitting}\n                    />\n                    <small>Leave blank to start immediately.</small>\n                  </label>\n\n                  <label>\n                    End Date\n                    <input\n                      type=\"date\"\n                      value={form.endDate}\n                      onChange={(event) =>\n                        handleFormChange(\"endDate\", event.target.value)\n                      }\n                      disabled={isSubmitting}\n                    />\n                    <small>Leave blank for no expiry.</small>\n                  </label>\n                </div>\n\n                <div className=\"admin-banner-form-actions\">\n                  <button\n                    type=\"button\"\n                    className=\"admin-banner-cancel-button\"\n                    onClick={resetForm}\n                    disabled={isSubmitting}\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"admin-banner-submit-button\"\n                    disabled={isSubmitting}\n                  >\n                    {isSubmitting\n                      ? \"Saving...\"\n                      : isEditing\n                        ? \"Update Banner\"\n                        : \"Save Banner\"}\n                  </button>\n                </div>\n              </form>\n            </div>\n          </div>\n        )}\n\n        {banners.length === 0 ? (\n          <div className=\"admin-banners-empty\">\n            <div className=\"admin-banners-empty-icon\">ðŸ–¼ï¸</div>\n            <h2>No banners yet</h2>\n            <p>\n              Add your first Home Page banner. Customers will see active banners\n              automatically.\n            </p>\n            <button type=\"button\" onClick={openAddForm}>\n              + Add First Banner\n            </button>\n          </div>\n        ) : (\n          <div className=\"admin-banners-list\">\n            {banners.map((banner) => (\n              <article className=\"admin-banner-card\" key={banner._id}>\n                <div\n                  className=\"admin-banner-card-image\"\n                  style={{ backgroundColor: \"var(--color-card-background)\" }}\n                >\n                  <img src={banner.image} alt=\"QuickCart banner\" />\n                  <span\n                    className={`admin-banner-status ${banner.isActive ? \"active\" : \"inactive\"}`}\n                  >\n                    {banner.isActive ? \"Active\" : \"Inactive\"}\n                  </span>\n                  <span className=\"admin-banner-order\">\n                    Order {banner.order}\n                  </span>\n                </div>\n\n                <div className=\"admin-banner-card-body\">\n                  <div>\n                    <span className=\"admin-banner-card-label\">IMAGE BANNER</span>\n                    <h2>QuickCart banner</h2>\n                  </div>\n\n                  <div className=\"admin-banner-card-meta\">\n                    <span>\n                      {banner.startDate\n                        ? `Starts ${new Date(banner.startDate).toLocaleDateString(\"en-IN\")}`\n                        : \"Starts immediately\"}\n                    </span>\n                    <span>\n                      {banner.endDate\n                        ? `Ends ${new Date(banner.endDate).toLocaleDateString(\"en-IN\")}`\n                        : \"No expiry\"}\n                    </span>\n                  </div>\n\n                  <div className=\"admin-banner-card-actions\">\n                    <button\n                      type=\"button\"\n                      className=\"edit\"\n                      onClick={() => openEditForm(banner)}\n                      disabled={busyBannerId === banner._id}\n                    >\n                      Edit\n                    </button>\n                    <button\n                      type=\"button\"\n                      className=\"status\"\n                      onClick={() => void handleToggleStatus(banner)}\n                      disabled={busyBannerId === banner._id}\n                    >\n                      {busyBannerId === banner._id\n                        ? \"Please wait...\"\n                        : banner.isActive\n                          ? \"Disable\"\n                          : \"Activate\"}\n                    </button>\n                    <button\n                      type=\"button\"\n                      className=\"delete\"\n                      onClick={() => void handleDelete(banner)}\n                      disabled={busyBannerId === banner._id}\n                    >\n                      Delete\n                    </button>\n                  </div>\n                </div>\n              </article>\n            ))}\n          </div>\n        )}\n        <Pagination currentPage={page} totalPages={totalPages} totalItems={totalItems} onPageChange={setPage} />\n      </div>\n    </div>\n  );\n};\n\nexport default AdminBanners;\n","usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminCategories.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nD:\\QuickCart\\client\\src\\pages\\admin\\AdminCategories.tsx:74:10\n  72 |\n  73 |   useEffect(() => {\n> 74 |     void fetchCategories();\n     |          ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  75 |   }, [page]);\n  76 |\n  77 |   const clearPreviewUrl = () => {","line":74,"column":10,"endLine":74,"endColumn":25},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchCategories'. Either include it or remove the dependency array.","line":75,"column":6,"endLine":75,"endColumn":12,"suggestions":[{"desc":"Update the dependencies array to be: [fetchCategories, page]","fix":{"range":[2372,2378],"text":"[fetchCategories, page]"}}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useDialogFocus } from \"../../hooks/useDialogFocus\";\nimport { useEffect, useState } from \"react\";\nimport axios from \"axios\";\n\nimport {\n  createAdminCategory,\n  deleteAdminCategory,\n  getAdminCategories,\n  updateAdminCategory,\n} from \"../../services/adminService\";\nimport type { Category } from \"../../types/product\";\nimport Pagination from \"../../components/common/Pagination\";\n\nimport \"./AdminCategories.css\";\n\nconst ALLOWED_IMAGE_TYPES = [\n  \"image/jpeg\",\n  \"image/png\",\n  \"image/webp\",\n  \"image/jpg\",\n];\n\nconst MAX_IMAGE_SIZE = 5 * 1024 * 1024;\n\nconst AdminCategories = () => {\n  const [categories, setCategories] = useState<Category[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [isDeleting, setIsDeleting] = useState<string | null>(null);\n\n  const [showForm, setShowForm] = useState(false);\n  const [editingCategory, setEditingCategory] = useState<Category | null>(null);\n\n  const [name, setName] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [imageFile, setImageFile] = useState<File | null>(null);\n  const [imagePreview, setImagePreview] = useState(\"\");\n\n  const [error, setError] = useState(\"\");\n  const [success, setSuccess] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [totalPages, setTotalPages] = useState(1);\n  const [totalItems, setTotalItems] = useState(0);\n\n  const fetchCategories = async (requestedPage = page) => {\n    try {\n      setIsLoading(true);\n      setError(\"\");\n\n      const response = await getAdminCategories(requestedPage, 10);\n\n      if (response?.success) {\n        setCategories(response.data || []);\n        setTotalPages(response.pagination?.totalPages || 1);\n        if (requestedPage > (response.pagination?.totalPages || 1)) setPage(response.pagination?.totalPages || 1);\n        setTotalItems(response.pagination?.totalItems || 0);\n      } else {\n        setError(\"Failed to load categories.\");\n      }\n    } catch (error: unknown) {\n      console.error(\"Get admin categories error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(error.response?.data?.message || \"Failed to load categories.\");\n      } else {\n        setError(\"Failed to load categories.\");\n      }\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    void fetchCategories();\n  }, [page]);\n\n  const clearPreviewUrl = () => {\n    if (imagePreview.startsWith(\"blob:\")) {\n      URL.revokeObjectURL(imagePreview);\n    }\n  };\n\n  const resetForm = () => {\n    clearPreviewUrl();\n\n    setName(\"\");\n    setDescription(\"\");\n    setImageFile(null);\n    setImagePreview(\"\");\n    setEditingCategory(null);\n    setShowForm(false);\n  };\n\n  const openAddForm = () => {\n    resetForm();\n    setError(\"\");\n    setSuccess(\"\");\n    setShowForm(true);\n  };\n\n  const openEditForm = (category: Category) => {\n    clearPreviewUrl();\n\n    setEditingCategory(category);\n    setName(category.name);\n    setDescription(category.description || \"\");\n    setImageFile(null);\n    setImagePreview(category.image || \"\");\n    setError(\"\");\n    setSuccess(\"\");\n    setShowForm(true);\n  };\n\n  const handleImageChange = (event: React.ChangeEvent<HTMLInputElement>) => {\n    const file = event.target.files?.[0];\n\n    if (!file) return;\n\n    if (!ALLOWED_IMAGE_TYPES.includes(file.type)) {\n      setError(\"Only JPG, JPEG, PNG and WEBP images are allowed.\");\n      event.target.value = \"\";\n      return;\n    }\n\n    if (file.size > MAX_IMAGE_SIZE) {\n      setError(\"Image size must be less than 5MB.\");\n      event.target.value = \"\";\n      return;\n    }\n\n    clearPreviewUrl();\n\n    setImageFile(file);\n    setImagePreview(URL.createObjectURL(file));\n    setError(\"\");\n    setSuccess(\"\");\n  };\n\n  const handleSubmit = async (event: React.FormEvent<HTMLFormElement>) => {\n    event.preventDefault();\n\n    setError(\"\");\n    setSuccess(\"\");\n\n    const trimmedName = name.trim();\n\n    if (!trimmedName) {\n      setError(\"Category name is required.\");\n      return;\n    }\n\n    if (!editingCategory && !imageFile) {\n      setError(\"Category image is required.\");\n      return;\n    }\n\n    try {\n      setIsSubmitting(true);\n\n      const formData = new FormData();\n      formData.append(\"name\", trimmedName);\n      formData.append(\"description\", description.trim());\n\n      if (imageFile) {\n        formData.append(\"image\", imageFile);\n      }\n\n      const response = editingCategory\n        ? await updateAdminCategory(editingCategory._id, formData)\n        : await createAdminCategory(formData);\n\n      if (!response?.success) {\n        throw new Error(\n          response?.message ||\n            (editingCategory\n              ? \"Failed to update category.\"\n              : \"Failed to create category.\"),\n        );\n      }\n\n      setSuccess(\n        editingCategory\n          ? \"Category updated successfully.\"\n          : \"Category added successfully.\",\n      );\n\n      resetForm();\n      await fetchCategories();\n    } catch (error: unknown) {\n      console.error(\n        editingCategory ? \"Update category error:\" : \"Create category error:\",\n        error,\n      );\n\n      if (axios.isAxiosError(error)) {\n        setError(\n          error.response?.data?.message ||\n            (editingCategory\n              ? \"Failed to update category.\"\n              : \"Failed to create category.\"),\n        );\n      } else {\n        setError(\n          error instanceof Error\n            ? error.message\n            : editingCategory\n              ? \"Failed to update category.\"\n              : \"Failed to create category.\",\n        );\n      }\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const handleDelete = async (category: Category) => {\n    const confirmed = window.confirm(\n      `Delete the \"${category.name}\" category? Categories with active products cannot be deleted.`,\n    );\n\n    if (!confirmed) return;\n\n    try {\n      setIsDeleting(category._id);\n      setError(\"\");\n      setSuccess(\"\");\n\n      const response = await deleteAdminCategory(category._id);\n\n      if (!response?.success) {\n        throw new Error(response?.message || \"Failed to delete category.\");\n      }\n\n      setCategories((previous) =>\n        previous.filter((item) => item._id !== category._id),\n      );\n      setSuccess(\"Category deleted successfully.\");\n    } catch (error: unknown) {\n      console.error(\"Delete category error:\", error);\n\n      if (axios.isAxiosError(error)) {\n        setError(error.response?.data?.message || \"Failed to delete category.\");\n      } else {\n        setError(\n          error instanceof Error ? error.message : \"Failed to delete category.\",\n        );\n      }\n    } finally {\n      setIsDeleting(null);\n    }\n  };\n\n  const dialogFocus = useDialogFocus<HTMLDivElement>(showForm && !isLoading, () => { if (!isSubmitting) resetForm(); });\n\n  if (isLoading) {\n    return (\n      <div className=\"admin-categories-page\">\n        <div className=\"admin-categories-loading\">Loading categories...</div>\n      </div>\n    );\n  }\n\n  const isEditing = Boolean(editingCategory);\n\n  return (\n    <div className=\"admin-categories-page\">\n      <div className=\"admin-categories-container\">\n        <div className=\"admin-categories-header\">\n          <div>\n            <h1>Manage Categories</h1>\n            <p>Add and manage the categories available in QuickCart.</p>\n          </div>\n\n          <button\n            type=\"button\"\n            className=\"admin-add-category-button\"\n            onClick={openAddForm}\n          >\n            + Add Category\n          </button>\n        </div>\n\n        {error && <div className=\"admin-category-message error\">{error}</div>}\n\n        {success && (\n          <div className=\"admin-category-message success\">{success}</div>\n        )}\n\n        {showForm && (\n          <div\n            {...dialogFocus}\n            className=\"admin-category-modal-overlay\"\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-labelledby=\"admin-category-modal-title\"\n            onMouseDown={(event) => {\n              if (event.target === event.currentTarget) {\n                resetForm();\n              }\n            }}\n          >\n            <div className=\"admin-category-form-card\">\n              <div className=\"admin-category-form-header\">\n                <div>\n                  <h2 id=\"admin-category-modal-title\">\n                    {isEditing ? \"Edit Category\" : \"Add New Category\"}\n                  </h2>\n                  <p>\n                    {isEditing\n                      ? \"Update the category name or replace its image.\"\n                      : \"Enter a category name and upload its image.\"}\n                  </p>\n                </div>\n\n                <button\n                  type=\"button\"\n                  className=\"admin-category-close-button\"\n                  onClick={resetForm}\n                  disabled={isSubmitting}\n                  aria-label=\"Close\"\n                >\n                  ×\n                </button>\n              </div>\n\n              <form onSubmit={handleSubmit} className=\"admin-category-form\">\n                <label>\n                  Category Name\n                  <input\n                    type=\"text\"\n                    value={name}\n                    onChange={(event) => setName(event.target.value)}\n                    placeholder=\"e.g. Fruits & Vegetables\"\n                    maxLength={80}\n                    disabled={isSubmitting}\n                  />\n                </label>\n\n                <label>\n                  Category Description\n                  <textarea value={description} onChange={(event) => setDescription(event.target.value)} maxLength={1200} rows={4} placeholder=\"Optional information shown on the category shopping page.\" disabled={isSubmitting} />\n                  <span className=\"admin-category-file-help\">Optional. Up to 1,200 characters.</span>\n                </label>\n\n                <label>\n                  Category Image\n                  <input\n                    type=\"file\"\n                    accept=\"image/jpeg,image/png,image/webp,image/jpg\"\n                    onChange={handleImageChange}\n                    disabled={isSubmitting}\n                  />\n                  <span className=\"admin-category-file-help\">\n                    JPG, JPEG, PNG or WEBP. Maximum size: 5MB.\n                    {isEditing ? \" Leave empty to keep the current image.\" : \"\"}\n                  </span>\n                </label>\n\n                {imagePreview && (\n                  <div className=\"admin-category-preview\">\n                    <img src={imagePreview} alt=\"Category preview\" />\n                  </div>\n                )}\n\n                <div className=\"admin-category-form-actions\">\n                  <button\n                    type=\"button\"\n                    className=\"admin-category-cancel-button\"\n                    onClick={resetForm}\n                    disabled={isSubmitting}\n                  >\n                    Cancel\n                  </button>\n\n                  <button\n                    type=\"submit\"\n                    className=\"admin-category-submit-button\"\n                    disabled={isSubmitting}\n                  >\n                    {isSubmitting\n                      ? isEditing\n                        ? \"Updating...\"\n                        : \"Adding...\"\n                      : isEditing\n                        ? \"Update Category\"\n                        : \"Add Category\"}\n                  </button>\n                </div>\n              </form>\n            </div>\n          </div>\n        )}\n\n        {categories.length === 0 ? (\n          <div className=\"admin-categories-empty\">\n            <div>🗂️</div>\n            <h3>No Categories Found</h3>\n            <p>Add your first QuickCart category.</p>\n          </div>\n        ) : (\n          <>\n          <div className=\"admin-categories-grid\">\n            {categories.map((category) => (\n              <div className=\"admin-category-card\" key={category._id}>\n                <div className=\"admin-category-image-wrapper\">\n                  {category.image ? (\n                    <img\n                      src={category.image}\n                      alt={category.name}\n                      className=\"admin-category-image\"\n                    />\n                  ) : (\n                    <div className=\"admin-category-no-image\">No Image</div>\n                  )}\n\n                  <span\n                    className={`admin-category-status ${\n                      category.isActive ? \"active\" : \"inactive\"\n                    }`}\n                  >\n                    {category.isActive ? \"Active\" : \"Inactive\"}\n                  </span>\n                </div>\n\n                <div className=\"admin-category-card-body\">\n                  <h3>{category.name}</h3>\n\n                  <div className=\"admin-category-card-actions\">\n                    <button\n                      type=\"button\"\n                      className=\"admin-category-edit-button\"\n                      onClick={() => openEditForm(category)}\n                      disabled={isDeleting === category._id}\n                    >\n                      Edit\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      className=\"admin-category-delete-button\"\n                      onClick={() => handleDelete(category)}\n                      disabled={isDeleting === category._id}\n                    >\n                      {isDeleting === category._id ? \"Deleting...\" : \"Delete\"}\n                    </button>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n          <Pagination currentPage={page} totalPages={totalPages} totalItems={totalItems} onPageChange={setPage} />\n          </>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default AdminCategories;\n","usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminFooter.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminHomepageSections.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nD:\\QuickCart\\client\\src\\pages\\admin\\AdminHomepageSections.tsx:46:26\n  44 |   }, []);\n  45 |\n> 46 |   useEffect(() => { void refresh(); }, [refresh]);\n     |                          ^^^^^^^ Avoid calling setState() directly within an effect\n  47 |\n  48 |   const hasChanges = comparable(draft) !== comparable(saved);\n  49 |   const selectedIds = useMemo(() => new Set(draft.map((section) => section.subCategoryId)), [draft]);","line":46,"column":26,"endLine":46,"endColumn":33}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import axios from \"axios\";\nimport { useCallback, useEffect, useMemo, useState } from \"react\";\n\nimport {\n  getAdminHomepageSections,\n  saveAdminHomepageSections,\n} from \"../../services/homepageSectionService\";\nimport type { AdminHomepageSection, HomepageSectionCategory } from \"../../types/homepageSection\";\nimport \"./AdminHomepageSections.css\";\n\nconst requestErrorText = (error: unknown) => axios.isAxiosError(error)\n  ? error.response?.data?.message || \"The request could not be completed.\"\n  : error instanceof Error ? error.message : \"The request could not be completed.\";\n\nconst parentName = (category: HomepageSectionCategory) => category.parentCategory?.name || \"Unavailable parent category\";\nconst comparable = (sections: AdminHomepageSection[]) => JSON.stringify(sections.map(({ subCategoryId, isActive, productLimit }) => ({ subCategoryId, isActive, productLimit })));\n\nconst AdminHomepageSections = () => {\n  const [available, setAvailable] = useState<HomepageSectionCategory[]>([]);\n  const [saved, setSaved] = useState<AdminHomepageSection[]>([]);\n  const [draft, setDraft] = useState<AdminHomepageSection[]>([]);\n  const [search, setSearch] = useState(\"\");\n  const [parentFilter, setParentFilter] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [saving, setSaving] = useState(false);\n  const [error, setError] = useState(\"\");\n  const [feedback, setFeedback] = useState(\"\");\n\n  const refresh = useCallback(async () => {\n    setLoading(true);\n    try {\n      const response = await getAdminHomepageSections();\n      if (!response.success) throw new Error(\"Failed to load homepage sections.\");\n      const sections = response.data.sections || [];\n      setAvailable(response.data.subcategories || []);\n      setSaved(sections);\n      setDraft(sections);\n      setError(\"\");\n    } catch (requestError) {\n      setError(requestErrorText(requestError));\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  useEffect(() => { void refresh(); }, [refresh]);\n\n  const hasChanges = comparable(draft) !== comparable(saved);\n  const selectedIds = useMemo(() => new Set(draft.map((section) => section.subCategoryId)), [draft]);\n  const parentCategories = useMemo(() => {\n    const parents = new Map<string, string>();\n    for (const category of available) parents.set(category.parentCategory._id, category.parentCategory.name);\n    return [...parents].map(([id, name]) => ({ id, name })).sort((a, b) => a.name.localeCompare(b.name));\n  }, [available]);\n  const filteredAvailable = useMemo(() => available.filter((category) =>\n    (!parentFilter || category.parentCategory._id === parentFilter) &&\n    `${category.name} ${parentName(category)}`.toLocaleLowerCase().includes(search.trim().toLocaleLowerCase()),\n  ), [available, parentFilter, search]);\n  const activeCount = draft.filter((section) => section.isActive).length;\n  const previewSections = draft.filter((section) =>\n    section.isActive && section.subCategory?.isActive && section.subCategory.parentCategory.isActive,\n  );\n\n  const addSection = (category: HomepageSectionCategory) => {\n    if (selectedIds.has(category._id)) return;\n    setDraft((current) => [...current, {\n      subCategoryId: category._id,\n      subCategory: category,\n      displayOrder: current.length,\n      isActive: true,\n      productLimit: 15,\n    }]);\n    setFeedback(\"\");\n  };\n\n  const removeSection = (section: AdminHomepageSection) => {\n    const name = section.subCategory?.name || \"unavailable subcategory\";\n    if (!window.confirm(`Remove ${name} from the homepage configuration?`)) return;\n    setDraft((current) => current.filter((item) => item.subCategoryId !== section.subCategoryId)\n      .map((item, displayOrder) => ({ ...item, displayOrder })));\n    setFeedback(\"\");\n  };\n\n  const moveSection = (index: number, offset: -1 | 1) => {\n    const nextIndex = index + offset;\n    if (nextIndex < 0 || nextIndex >= draft.length) return;\n    const next = [...draft];\n    [next[index], next[nextIndex]] = [next[nextIndex], next[index]];\n    setDraft(next.map((item, displayOrder) => ({ ...item, displayOrder })));\n    setFeedback(\"\");\n  };\n\n  const updateSection = (subCategoryId: string, patch: Partial<AdminHomepageSection>) => {\n    setDraft((current) => current.map((item) => item.subCategoryId === subCategoryId ? { ...item, ...patch } : item));\n    setFeedback(\"\");\n  };\n\n  const resetChanges = () => {\n    setDraft(saved);\n    setFeedback(\"\");\n    setError(\"\");\n  };\n\n  const saveChanges = async () => {\n    if (saving || !hasChanges) return;\n    setSaving(true);\n    setError(\"\");\n    setFeedback(\"\");\n    try {\n      const response = await saveAdminHomepageSections(draft);\n      if (!response.success) throw new Error(\"Failed to save homepage sections.\");\n      const sections = response.data.sections || [];\n      setSaved(sections);\n      setDraft(sections);\n      setAvailable(response.data.subcategories || available);\n      setFeedback(\"Homepage sections saved.\");\n    } catch (requestError) {\n      setError(requestErrorText(requestError));\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  return (\n    <div className=\"admin-homepage-sections\">\n      <header className=\"ahs-header\">\n        <div>\n          <span className=\"ahs-eyebrow\">HOMEPAGE</span>\n          <h1>Homepage Sections</h1>\n          <p>Manage the subcategories displayed on your customer homepage and control their visibility and display order.</p>\n        </div>\n        <div className=\"ahs-header-actions\">\n          <button type=\"button\" className=\"ahs-button ahs-secondary\" onClick={resetChanges} disabled={!hasChanges || saving}>Reset changes</button>\n          <button type=\"button\" className=\"ahs-button\" onClick={() => void saveChanges()} disabled={!hasChanges || saving || loading}>{saving ? \"Saving…\" : \"Save Changes\"}</button>\n        </div>\n      </header>\n\n      <section className=\"ahs-stats\" aria-label=\"Homepage section totals\">\n        <article><span>Selected sections</span><strong>{draft.length}</strong></article>\n        <article><span>Active sections</span><strong>{activeCount}</strong></article>\n      </section>\n\n      {error && <div className=\"ahs-message error\" role=\"alert\"><span>{error}</span><button type=\"button\" onClick={() => void refresh()} disabled={loading}>Retry loading</button></div>}\n      {feedback && <div className=\"ahs-message success\" role=\"status\">{feedback}</div>}\n\n      {loading ? (\n        <div className=\"ahs-loading\" role=\"status\">Loading homepage section settings…</div>\n      ) : (\n        <div className=\"ahs-grid\">\n          <section className=\"ahs-card\">\n            <div className=\"ahs-card-heading\">\n              <div><h2>Available subcategories</h2><p>Add active subcategories to the customer homepage.</p></div>\n              <span className=\"ahs-count\">{available.length} available</span>\n            </div>\n            <div className=\"ahs-filters\">\n              <label>Search subcategories<input type=\"search\" value={search} onChange={(event) => setSearch(event.target.value)} placeholder=\"Search by name\" /></label>\n              <label>Parent category<select value={parentFilter} onChange={(event) => setParentFilter(event.target.value)}><option value=\"\">All parent categories</option>{parentCategories.map((parent) => <option key={parent.id} value={parent.id}>{parent.name}</option>)}</select></label>\n            </div>\n            {filteredAvailable.length ? (\n              <ul className=\"ahs-available-list\">\n                {filteredAvailable.map((category) => {\n                  const isSelected = selectedIds.has(category._id);\n                  return <li key={category._id}>\n                    {category.image ? <img src={category.image} alt=\"\" /> : <span className=\"ahs-image-placeholder\" aria-hidden=\"true\">▧</span>}\n                    <span className=\"ahs-category-name\"><strong>{category.name}</strong><small>{parentName(category)}</small></span>\n                    <button type=\"button\" className={isSelected ? \"ahs-selected\" : \"\"} onClick={() => addSection(category)} disabled={isSelected}>{isSelected ? \"Selected\" : \"Add section\"}</button>\n                  </li>;\n                })}\n              </ul>\n            ) : <p className=\"ahs-empty\">No matching active subcategories.</p>}\n          </section>\n\n          <section className=\"ahs-card\">\n            <div className=\"ahs-card-heading\">\n              <div><h2>Selected homepage sections</h2><p>Use the arrows to change order. Inactive sections remain saved.</p></div>\n            </div>\n            {draft.length ? (\n              <ol className=\"ahs-selected-list\">\n                {draft.map((section, index) => <li key={section.subCategoryId}>\n                  <div className=\"ahs-order-controls\">\n                    <strong>{index + 1}</strong>\n                    <button type=\"button\" aria-label={`Move ${section.subCategory?.name || \"section\"} up`} onClick={() => moveSection(index, -1)} disabled={index === 0}>↑</button>\n                    <button type=\"button\" aria-label={`Move ${section.subCategory?.name || \"section\"} down`} onClick={() => moveSection(index, 1)} disabled={index === draft.length - 1}>↓</button>\n                  </div>\n                  {section.subCategory?.image ? <img src={section.subCategory.image} alt=\"\" /> : <span className=\"ahs-image-placeholder\" aria-hidden=\"true\">▧</span>}\n                  <div className=\"ahs-section-details\">\n                    <strong>{section.subCategory?.name || \"Unavailable subcategory\"}</strong>\n                    <small>{section.subCategory\n                      ? `${parentName(section.subCategory)}${section.subCategory.isActive && section.subCategory.parentCategory.isActive ? \"\" : \" · Category unavailable\"}`\n                      : \"This category was removed. Remove this saved section.\"}</small>\n                    <label>Products to show<input type=\"number\" min={1} max={15} value={section.productLimit} onChange={(event) => updateSection(section.subCategoryId, { productLimit: Math.max(1, Math.min(15, Number(event.target.value) || 1)) })} /></label>\n                  </div>\n                  <label className=\"ahs-toggle\"><input type=\"checkbox\" checked={section.isActive} onChange={(event) => updateSection(section.subCategoryId, { isActive: event.target.checked })} /><span>{section.isActive ? \"Active\" : \"Inactive\"}</span></label>\n                  <button type=\"button\" className=\"ahs-remove\" onClick={() => removeSection(section)} aria-label={`Remove ${section.subCategory?.name || \"unavailable section\"}`}>Remove</button>\n                </li>)}\n              </ol>\n            ) : <p className=\"ahs-empty\">No homepage sections selected. Add subcategories from the list.</p>}\n            <div className=\"ahs-preview\">\n              <h3>Homepage preview</h3>\n              {previewSections.length ? (\n                <div className=\"ahs-preview-list\">{previewSections.map((section) => <span key={section.subCategoryId}>{section.subCategory?.name}</span>)}</div>\n              ) : <p>No active sections will appear on the homepage.</p>}\n            </div>\n          </section>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default AdminHomepageSections;\n","usedDeprecatedRules":[]},{"filePath":"D:\\QuickCart\\client\\src\\pages\\admin\\AdminLogin.tsx","messages":[],"suppressedMessages":[],"errorCount