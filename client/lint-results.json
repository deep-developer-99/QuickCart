pName || item.vendor.name || \"N/A\"\r\n                          : \"N/A\";\r\n\r\n                      const effectivePrice = item.discountedPrice ?? item.price;\r\n\r\n                      return (\r\n                        <div\r\n                          className=\"admin-order-item\"\r\n                          key={`${order._id}-${index}`}\r\n                        >\r\n                          <img src={item.image} alt={item.name} />\r\n\r\n                          <div className=\"admin-order-item-info\">\r\n                            <strong>{item.name}</strong>\r\n\r\n                            <span>Vendor: {vendor}</span>\r\n\r\n                            <span>Quantity: {item.quantity}</span>\r\n                            {item.variantQuantity != null && item.variantUnit && <span>Variant: {item.variantQuantity} {item.variantUnit}</span>}\r\n                          </div>\r\n\r\n                          <div className=\"admin-order-item-price\">\r\n                            <strong>₹{effectivePrice}</strong>\r\n\r\n                            {item.discountedPrice !== undefined &&\r\n                              item.discountedPrice < item.price && (\r\n                                <span>₹{item.price}</span>\r\n                              )}\r\n                          </div>\r\n                        </div>\r\n                      );\r\n                    })}\r\n                  </div>\r\n\r\n                  <div className=\"admin-order-footer\">\r\n                    <div>\r\n                      <span>Payment</span>\r\n                      <strong>\r\n                        {order.paymentMethod === \"COD\"\r\n                          ? \"Cash on Delivery\"\r\n                          : \"Fake Razorpay\"}\r\n                      </strong>\r\n                    </div>\r\n\r\n                    <div>\r\n                      <span>Total</span>\r\n                      <strong className=\"order-total\">\r\n         